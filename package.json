{
    "name": "renaissance-plugin-frontend",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start:renaissance-plugin": "ng serve renaissance-plugin -o",
        "build:renaissance-plugin": "ng build renaissance-plugin --configuration production",
        "start": "npm run start:renaissance-plugin",
        "build": "npm run build:renaissance-plugin",
        "java:jar": "./mvnw -ntp verify -DskipTests --batch-mode",
        "dev:run": "./mvnw spring-boot:run -Dspring-boot.run.profiles=dev",
        "translate": " yarn json-autotranslate --type keybased -i src/main/resources/installers/renaissance-plugin/i18n -c translation_config.json  --fix-inconsistencies -m i18next --directory-structure ngx-translate",
        "test": "npx jest"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "19.0.0",
        "@angular/cdk": "19.0.0",
        "@angular/common": "19.0.0",
