        "@angular/core": "19.0.0",
        "@angular/elements": "^19.0.0",
        "@angular/forms": "19.0.0",
        "@angular/material": "19.0.0",
        "@angular/material-luxon-adapter": "19.0.0",
        "@angular/platform-browser": "19.0.0",
        "@angular/platform-browser-dynamic": "19.0.0",
        "@angular/router": "19.0.0",
        "@jsverse/transloco": "7.5.0",
        "@mattae/angular-shared": "^1.0.8",
        "apollo-angular": "^5.0.2",
        "graphql": "^16.8.1",
        "graphql-ws": "^5.14.2",
        "lodash": "4.17.21",
        "luxon": "3.3.0",
        "luxon-angular": "^6.0.0",
        "ngx-editor": "^19.0.0-beta.1",
        "ngx-material-luxon": "^1.1.1",
        "perfect-scrollbar": "^1.5.5",
        "randexp": "^0.5.3",
        "rxjs": "7.8.1",
        "tslib": "2.8.0"
    },
    "devDependencies": {
        "@angular-architects/module-federation": "^18.0.6",
        "@angular-architects/module-federation-runtime": "^18.0.6",
        "@angular-devkit/build-angular": "^19.0.2",
        "@angular/cli": "^19.0.2",
        "@angular/compiler-cli": "^19.0.1",
        "@tailwindcss/typography": "^0.5.15",
        "@types/color": "^4.2.0",
