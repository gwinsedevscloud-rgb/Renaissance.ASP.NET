<td class="text-end module-table-actions">
    <div class="client-actions">
        <a class="btn btn-sm btn-outline-primary" href="@Href" title="@Title">
            <i class="bi @Icon"></i>
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                <span>@Label</span>
            }
        </a>
    </div>
</td>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Open";
    [Parameter] public string Icon { get; set; } = "bi-pencil";
    [Parameter] public string? Label { get; set; }
}
