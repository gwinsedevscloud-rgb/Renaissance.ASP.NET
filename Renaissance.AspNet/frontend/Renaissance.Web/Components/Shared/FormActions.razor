<div class="form-footer">
    <button type="submit" class="btn btn-primary btn-form-primary" disabled="@Saving">
        @if (Saving)
        {
            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
        }
        else
        {
            <i class="bi @SaveIcon me-1"></i>
        }
        @SaveLabel
    </button>
    @if (ShowReferAfterSave)
    {
        <button type="button"
                class="btn btn-outline-primary"
                disabled="@Saving"
                @onclick="ReferAfterSaveAsync">
            <i class="bi bi-send-check me-1"></i>
            @ReferAfterSaveLabel
        </button>
    }
    @if (!string.IsNullOrEmpty(CancelHref))
    {
        <a class="btn btn-outline-secondary" href="@CancelHref">
            <i class="bi bi-x-lg me-1"></i> Cancel
        </a>
    }
    @if (Extra is not null)
    {
        @Extra
    }
</div>

@code {
    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    [Parameter]
    public string SaveLabel { get; set; } = "Save";

    [Parameter]
    public string SaveIcon { get; set; } = "bi-check-lg";

    [Parameter]
    public string? CancelHref { get; set; }

    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public bool ShowReferAfterSave { get; set; }

    [Parameter]
    public string ReferAfterSaveLabel { get; set; } = "Save & refer to another module";

    [Parameter]
    public EventCallback OnReferAfterSave { get; set; }

    [Parameter]
    public RenderFragment? Extra { get; set; }

    private async Task ReferAfterSaveAsync()
    {
        if (EditContext is not null && !EditContext.Validate())
        {
            return;
        }

        await OnReferAfterSave.InvokeAsync();
    }
}
