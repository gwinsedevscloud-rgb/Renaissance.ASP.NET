@using Renaissance.Web.Models
@using Renaissance.Web.Helpers

<div class="triage-form triage-form-station">
    <aside class="triage-monitor @(_hasVitals ? "is-live" : "") @(Bmi.HasValue ? "has-bmi" : "")" aria-label="Live vitals and BMI">
        <div class="bmi-gauge @BmiCssClass @(Bmi.HasValue ? "has-value" : "")" aria-live="polite">
            <div class="bmi-gauge-top">
                <div class="bmi-gauge-title-block">
                    <span class="bmi-gauge-title">Body mass index (WHO)</span>
                    <strong class="bmi-gauge-value">@(Bmi?.ToString("0.0") ?? "—")</strong>
                </div>
                @if (Bmi.HasValue)
                {
                    <span class="bmi-gauge-badge is-active">
                        <i class="bmi-gauge-badge-dot" aria-hidden="true"></i>
                        <span class="bmi-gauge-badge-text">
                            <strong>@BmiCategory</strong>
                            <small>@((MarkupString)BmiRangeLabel)</small>
                        </span>
                    </span>
                }
                else
                {
                    <span class="bmi-gauge-badge">
                        <i class="bmi-gauge-badge-dot" aria-hidden="true"></i>
                        Enter weight &amp; height
                    </span>
                }
            </div>

            <div class="bmi-gauge-legend" aria-hidden="true">
                <span class="@(BmiCssClass == "bmi-underweight" ? "is-active" : null)"><i class="bmi-dot bmi-dot-under"></i> Underweight (&lt;18.5)</span>
                <span class="@(BmiCssClass == "bmi-normal" ? "is-active" : null)"><i class="bmi-dot bmi-dot-normal"></i> Normal (18.5–24.9)</span>
                <span class="@(BmiCssClass == "bmi-overweight" ? "is-active" : null)"><i class="bmi-dot bmi-dot-over"></i> Overweight (25–29.9)</span>
                <span class="@(BmiCssClass == "bmi-obese" ? "is-active" : null)"><i class="bmi-dot bmi-dot-obese"></i> Obese (≥30)</span>
            </div>

            <div class="bmi-gauge-chart">
                <svg viewBox="0 0 240 148" class="bmi-gauge-svg" role="img" aria-label="@(Bmi.HasValue ? $"BMI {Bmi:0.0}, {BmiCategory}" : "BMI gauge waiting for measurements")">
                    @* Track *@
                    <path class="bmi-arc-track" d="@DescribeArc(15, 40)" />

                    @* Colored segments — active category is highlighted via CSS *@
                    <path class="bmi-arc bmi-arc-under @(BmiCssClass == "bmi-underweight" ? "is-active" : null)" d="@DescribeArc(15, 18.5)" />
                    <path class="bmi-arc bmi-arc-normal @(BmiCssClass == "bmi-normal" ? "is-active" : null)" d="@DescribeArc(18.5, 25)" />
                    <path class="bmi-arc bmi-arc-over @(BmiCssClass == "bmi-overweight" ? "is-active" : null)" d="@DescribeArc(25, 30)" />
                    <path class="bmi-arc bmi-arc-obese @(BmiCssClass == "bmi-obese" ? "is-active" : null)" d="@DescribeArc(30, 40)" />

                    @* Tick marks + labels *@
                    @foreach (var tick in BmiTicks)
                    {
                        var a = BmiToAngle(tick);
                        var outer = Polar(GaugeCx, GaugeCy, GaugeR + 2, a);
                        var inner = Polar(GaugeCx, GaugeCy, GaugeR - 8, a);
                        var label = Polar(GaugeCx, GaugeCy, GaugeR + 16, a);
                        <line class="bmi-tick" x1="@Svg(outer.X)" y1="@Svg(outer.Y)" x2="@Svg(inner.X)" y2="@Svg(inner.Y)" />
                        @((MarkupString)TickLabelMarkup(label.X, label.Y, FormatTick(tick)))
                    }

                    @* Needle tip computed in polar coords (no rotate — reliable across locales) *@
                    @{
                        var tip = Polar(GaugeCx, GaugeCy, GaugeR - 12, NeedleAngle);
                    }
                    <g class="bmi-needle @(Bmi.HasValue ? "is-ready" : null)">
                        <line x1="@Svg(GaugeCx)" y1="@Svg(GaugeCy)" x2="@Svg(tip.X)" y2="@Svg(tip.Y)" />
                        <circle class="bmi-needle-tip" cx="@Svg(tip.X)" cy="@Svg(tip.Y)" r="3.5" />
                        <circle class="bmi-needle-hub" cx="@Svg(GaugeCx)" cy="@Svg(GaugeCy)" r="6" />
                        <circle class="bmi-needle-hub-inner" cx="@Svg(GaugeCx)" cy="@Svg(GaugeCy)" r="2.4" />
                    </g>
                </svg>
            </div>

            <div class="bmi-category-row" role="list" aria-label="BMI classification">
                <div class="bmi-category-chip bmi-chip-under @(BmiCssClass == "bmi-underweight" ? "is-active" : null)" role="listitem">Underweight</div>
                <div class="bmi-category-chip bmi-chip-normal @(BmiCssClass == "bmi-normal" ? "is-active" : null)" role="listitem">Normal</div>
                <div class="bmi-category-chip bmi-chip-over @(BmiCssClass == "bmi-overweight" ? "is-active" : null)" role="listitem">Overweight</div>
                <div class="bmi-category-chip bmi-chip-obese @(BmiCssClass == "bmi-obese" ? "is-active" : null)" role="listitem">Obese</div>
            </div>

            @if (Bmi.HasValue)
            {
                <div class="bmi-gauge-result">
                    <span class="bmi-gauge-result-label">Classification</span>
                    <strong class="bmi-gauge-result-value">@BmiCategory</strong>
                </div>
            }
        </div>

        <div class="triage-monitor-grid triage-monitor-grid-compact">
            <div class="triage-monitor-card @TriageVitalsHelper.BpCssClass(Model.SystolicBp, Model.DiastolicBp)">
                <span class="triage-monitor-label">Blood pressure</span>
                <strong class="triage-monitor-value">@(Model.SystolicBp is not null && Model.DiastolicBp is not null ? $"{Model.SystolicBp}/{Model.DiastolicBp}" : "—")</strong>
                <small>mmHg</small>
            </div>
            <div class="triage-monitor-card @TriageVitalsHelper.TempCssClass(Model.Temperature)">
                <span class="triage-monitor-label">Temperature</span>
                <strong class="triage-monitor-value">@(Model.Temperature?.ToString("0.0") ?? "—")</strong>
                <small>°C</small>
            </div>
            <div class="triage-monitor-card @TriageVitalsHelper.PulseCssClass(Model.PulseRate)">
                <span class="triage-monitor-label">Pulse</span>
                <strong class="triage-monitor-value">@(Model.PulseRate?.ToString() ?? "—")</strong>
                <small>bpm</small>
            </div>
        </div>
    </aside>

    <div class="triage-form-panels">
        <section class="triage-panel">
            <div class="triage-panel-head">
                <span class="triage-panel-icon"><i class="bi bi-person-lines-fill"></i></span>
                <div>
                    <h3>Body measurements</h3>
                    <p>WHO adult BMI updates live from weight and height</p>
                </div>
            </div>
            <div class="triage-input-row">
                <div class="triage-field">
                    <FormLabel Text="Weight (kg)" Icon="bi-speedometer" />
                    <InputNumber class="form-control" @bind-Value="Model.Weight" @bind-Value:after="OnVitalsChanged" />
                </div>
                <div class="triage-field">
                    <FormLabel Text="Height (cm)" Icon="bi-rulers" />
                    <InputNumber class="form-control" @bind-Value="Model.Height" @bind-Value:after="OnVitalsChanged" />
                </div>
            </div>
        </section>

        <section class="triage-panel">
            <div class="triage-panel-head">
                <span class="triage-panel-icon"><i class="bi bi-heart-pulse"></i></span>
                <div>
                    <h3>Cardiovascular</h3>
                    <p>Blood pressure and pulse rate</p>
                </div>
            </div>
            <div class="triage-input-row triage-input-row-3">
                <div class="triage-field">
                    <FormLabel Text="Systolic BP" Icon="bi-heart-pulse" />
                    <InputNumber class="form-control" @bind-Value="Model.SystolicBp" @bind-Value:after="OnVitalsChanged" />
                </div>
                <div class="triage-field">
                    <FormLabel Text="Diastolic BP" Icon="bi-heart-pulse" />
                    <InputNumber class="form-control" @bind-Value="Model.DiastolicBp" @bind-Value:after="OnVitalsChanged" />
                </div>
                <div class="triage-field">
                    <FormLabel Text="Pulse rate" Icon="bi-activity" />
                    <InputNumber class="form-control" @bind-Value="Model.PulseRate" @bind-Value:after="OnVitalsChanged" />
                </div>
            </div>
        </section>

        <section class="triage-panel">
            <div class="triage-panel-head">
                <span class="triage-panel-icon"><i class="bi bi-lungs"></i></span>
                <div>
                    <h3>Respiratory</h3>
                    <p>Temperature and breathing rate</p>
                </div>
            </div>
            <div class="triage-input-row">
                <div class="triage-field">
                    <FormLabel Text="Temperature (°C)" Icon="bi-thermometer-half" />
                    <InputNumber class="form-control" @bind-Value="Model.Temperature" @bind-Value:after="OnVitalsChanged" />
                </div>
                <div class="triage-field">
                    <FormLabel Text="Respiratory rate" Icon="bi-lungs" />
                    <InputNumber class="form-control" @bind-Value="Model.RespiratoryRate" @bind-Value:after="OnVitalsChanged" />
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private const double GaugeCx = 120;
    private const double GaugeCy = 118;
    private const double GaugeR = 78;
    private static readonly double[] BmiTicks = [15, 18.5, 25, 30, 40];
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    [Parameter, EditorRequired]
    public Triage Model { get; set; } = null!;

    private double? Bmi => TriageVitalsHelper.CalculateBmi(Model.Weight, Model.Height);
    private string BmiCategory => TriageVitalsHelper.BmiCategory(Bmi);
    private string BmiRangeLabel => TriageVitalsHelper.BmiRangeLabel(Bmi);
    private string BmiCssClass => TriageVitalsHelper.BmiCssClass(Bmi);
    private double NeedleAngle => TriageVitalsHelper.BmiNeedleAngle(Bmi);

    private bool _hasVitals =>
        Model.Weight is > 0 || Model.Height is > 0 || Model.Temperature is not null
        || Model.PulseRate is not null || Model.SystolicBp is not null || Model.DiastolicBp is not null;

    private void OnVitalsChanged() => StateHasChanged();

    private static string Svg(double value) => value.ToString("0.##", Inv);

    private static double BmiToAngle(double bmi) =>
        180d - ((Math.Clamp(bmi, TriageVitalsHelper.BmiGaugeMin, TriageVitalsHelper.BmiGaugeMax)
                 - TriageVitalsHelper.BmiGaugeMin)
                / (TriageVitalsHelper.BmiGaugeMax - TriageVitalsHelper.BmiGaugeMin)) * 180d;

    private static string FormatTick(double tick) =>
        tick % 1 == 0 ? tick.ToString("0", Inv) : tick.ToString("0.0", Inv);

    private static string TickLabelMarkup(double x, double y, string label) =>
        $"<text class=\"bmi-tick-label\" x=\"{Svg(x)}\" y=\"{Svg(y)}\" text-anchor=\"middle\" dominant-baseline=\"middle\">{System.Net.WebUtility.HtmlEncode(label)}</text>";

    private static (double X, double Y) Polar(double cx, double cy, double r, double angleDeg)
    {
        var rad = angleDeg * Math.PI / 180d;
        return (cx + r * Math.Cos(rad), cy - r * Math.Sin(rad));
    }

    private static string DescribeArc(double bmiFrom, double bmiTo)
    {
        var start = Polar(GaugeCx, GaugeCy, GaugeR, BmiToAngle(bmiFrom));
        var end = Polar(GaugeCx, GaugeCy, GaugeR, BmiToAngle(bmiTo));
        var largeArc = Math.Abs(BmiToAngle(bmiFrom) - BmiToAngle(bmiTo)) > 180 ? 1 : 0;
        // Sweep 0 = counterclockwise → top semicircle (y grows downward in SVG)
        return $"M {Svg(start.X)} {Svg(start.Y)} A {Svg(GaugeR)} {Svg(GaugeR)} 0 {largeArc} 0 {Svg(end.X)} {Svg(end.Y)}";
    }
}
