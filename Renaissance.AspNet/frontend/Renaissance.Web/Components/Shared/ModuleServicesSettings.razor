@inject RenaissanceApiClient Api
@inject HospitalModuleStateService ModuleState

<div class="form-card admin-settings-card module-services-settings mt-4">
    <div class="admin-settings-section-head">
        <span class="section-icon feature-icon-indigo"><i class="bi bi-grid-3x3-gap-fill"></i></span>
        <div class="flex-grow-1">
            <h2 class="h5 mb-1">Clinical services</h2>
            <p class="text-muted small mb-0">
                Add or remove modules for this hospital and define how they interconnect through referrals.
            </p>
        </div>
        @if (_config is not null)
        {
            <div class="admin-settings-module-stats">
                <span class="record-chip is-positive"><i class="bi bi-check2-circle"></i>@_enabled.Count active</span>
                @if (_config.UpdatedAtUtc is not null)
                {
                    <span class="record-meta mb-0">Updated @_config.UpdatedAtUtc.Value.ToLocalTime().ToString("g")</span>
                }
            </div>
        }
    </div>

    @if (_loading)
    {
        <LoadingState Message="Loading module configuration..." />
    }
    else if (_config is null)
    {
        <p class="text-muted mb-0">Unable to load module settings.</p>
    }
    else
    {
        <FormSection Title="Service modules"
                     Subtitle="Toggle clinical departments available to staff"
                     Icon="bi-toggle-on"
                     IconBgClass="feature-icon-teal">
            <div class="row g-3">
                @foreach (var service in _config.Services.Where(s => !s.IsCore))
                {
                    var enabled = _enabled.Contains(service.Module);
                    var nav = ModuleNav.All.FirstOrDefault(m => m.Module == service.Module);
                    var accent = ModuleAccentClass(service.Module);
                    <div class="col-md-6 col-xl-4">
                        <label class="module-service-card @accent @(enabled ? "enabled" : "disabled")">
                            <div class="module-service-card-head">
                                <span class="module-service-icon @accent">
                                    <i class="bi @(nav?.Icon ?? "bi-grid")"></i>
                                </span>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@enabled"
                                           @onchange="e => ToggleService(service.Module, e.Value)" />
                                </div>
                            </div>
                            <strong>@service.Name</strong>
                            <small class="text-muted d-block">@service.Description</small>
                            <span class="module-service-tag">@service.Category</span>
                        </label>
                    </div>
                }
            </div>
        </FormSection>

        <FormSection Title="Referral interconnections"
                     Subtitle="Choose which enabled services can send patients to one another"
                     Icon="bi-arrow-left-right"
                     IconBgClass="feature-icon-violet"
                     Collapsible="true"
                     InitiallyExpanded="@(_enabled.Count >= 2)">
            <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ConnectAllReferrals">
                    <i class="bi bi-diagram-3 me-1"></i> Connect all
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearReferralLinks">
                    <i class="bi bi-x-circle me-1"></i> Clear links
                </button>
            </div>

            @if (_referralModules.Count == 0)
            {
                <div class="admin-settings-empty-hint">
                    <i class="bi bi-info-circle"></i>
                    <p class="mb-0">Enable at least two referral-capable services to configure connections.</p>
                </div>
            }
            else
            {
                <div class="table-responsive module-referral-matrix-wrap">
                    <table class="table table-sm module-referral-matrix mb-0">
                        <thead>
                            <tr>
                                <th>From \ To</th>
                                @foreach (var target in _referralTargets.Where(_enabled.Contains))
                                {
                                    <th><span class="module-referral-col-label">@ModuleNav.DisplayName(target)</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var source in _referralSources.Where(_enabled.Contains))
                            {
                                <tr>
                                    <th>@ModuleNav.DisplayName(source)</th>
                                    @foreach (var target in _referralTargets.Where(_enabled.Contains))
                                    {
                                        var on = source != target && HasLink(source, target);
                                        var disabled = source == target;
                                        <td class="@(disabled ? "is-disabled" : on ? "is-linked" : "")">
                                            @if (!disabled)
                                            {
                                                <label class="module-referral-check">
                                                    <input type="checkbox"
                                                           checked="@on"
                                                           @onchange="e => ToggleLink(source, target, e.Value)" />
                                                    <span class="module-referral-check-ui"><i class="bi bi-check-lg"></i></span>
                                                </label>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </FormSection>

        <div class="admin-settings-save-bar">
            <p class="text-muted small mb-0">Changes apply immediately after saving. Staff may need to sign in again.</p>
            <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="SaveAsync">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <i class="bi bi-check2-circle me-1"></i>
                Save module configuration
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public EventCallback<string?> OnMessage { get; set; }
    [Parameter] public EventCallback<string?> OnError { get; set; }

    private HospitalModulesConfigDto? _config;
    private HashSet<AppModule> _enabled = [];
    private HashSet<(AppModule Source, AppModule Target)> _links = [];
    private List<AppModule> _referralSources = [];
    private List<AppModule> _referralTargets = [];
    private List<AppModule> _referralModules = [];
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _config = await Api.GetHospitalModulesConfigAsync();
            _enabled = _config.Services.Where(s => !s.IsCore && s.IsEnabled).Select(s => s.Module).ToHashSet();
            _links = _config.ReferralLinks.Select(l => (l.SourceModule, l.TargetModule)).ToHashSet();
            RebuildReferralLists();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private void RebuildReferralLists()
    {
        _referralSources =
        [
            AppModule.Triage,
            AppModule.Consultations,
            AppModule.Pharmacy,
            AppModule.Laboratory,
            AppModule.Dental,
            AppModule.Ancillary,
            AppModule.Optometrists,
            AppModule.Ophthalmologists
        ];

        _referralTargets =
        [
            AppModule.Consultations,
            AppModule.Pharmacy,
            AppModule.Laboratory,
            AppModule.Dental,
            AppModule.Ancillary,
            AppModule.Optometrists,
            AppModule.Ophthalmologists
        ];

        _referralModules = _referralSources
            .Concat(_referralTargets)
            .Where(_enabled.Contains)
            .Distinct()
            .OrderBy(m => (int)m)
            .ToList();
    }

    private void ToggleService(AppModule module, object? value)
    {
        var on = value is true || value?.ToString() == "True";
        if (on)
        {
            _enabled.Add(module);
        }
        else
        {
            _enabled.Remove(module);
            _links.RemoveWhere(l => l.Source == module || l.Target == module);
        }

        RebuildReferralLists();
    }

    private bool HasLink(AppModule source, AppModule target) => _links.Contains((source, target));

    private void ToggleLink(AppModule source, AppModule target, object? value)
    {
        var on = value is true || value?.ToString() == "True";
        if (on)
        {
            _links.Add((source, target));
        }
        else
        {
            _links.Remove((source, target));
        }
    }

    private void ConnectAllReferrals()
    {
        foreach (var source in _referralSources.Where(_enabled.Contains))
        {
            foreach (var target in _referralTargets.Where(_enabled.Contains))
            {
                if (source != target)
                {
                    _links.Add((source, target));
                }
            }
        }
    }

    private void ClearReferralLinks() => _links.Clear();

    private async Task SaveAsync()
    {
        if (_enabled.Count == 0)
        {
            await OnError.InvokeAsync("At least one clinical service must remain enabled.");
            return;
        }

        _saving = true;
        await OnError.InvokeAsync(null);
        try
        {
            _config = await Api.UpdateHospitalModulesConfigAsync(new UpdateHospitalModulesRequest
            {
                EnabledModules = _enabled.OrderBy(m => (int)m).ToList(),
                ReferralLinks = _links
                    .Select(l => new ModuleReferralLinkDto { SourceModule = l.Source, TargetModule = l.Target })
                    .OrderBy(l => (int)l.SourceModule)
                    .ThenBy(l => (int)l.TargetModule)
                    .ToList()
            });

            var active = await Api.GetActiveHospitalModulesAsync();
            ModuleState.Apply(active);
            await OnMessage.InvokeAsync("Module configuration saved. Staff may need to sign in again to refresh their menus.");
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ModuleAccentClass(AppModule module) => module switch
    {
        AppModule.Triage => "home-accent-coral",
        AppModule.Consultations => "home-accent-slate",
        AppModule.Pharmacy => "home-accent-indigo",
        AppModule.Laboratory => "home-accent-sky",
        AppModule.Dental => "home-accent-amber",
        AppModule.Ancillary => "home-accent-rose",
        AppModule.Optometrists => "home-accent-violet",
        AppModule.Ophthalmologists => "home-accent-emerald",
        AppModule.Stakeholders => "home-accent-gold",
        _ => "home-accent-teal"
    };
}
