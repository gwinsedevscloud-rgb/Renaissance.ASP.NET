<th class="@CssClass" scope="col">
    <span class="module-th-label">
        <span class="module-th-icon" aria-hidden="true"><i class="bi @Icon"></i></span>
        <span class="module-th-text">@Label</span>
    </span>
</th>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "bi-dot";
    [Parameter] public string? CssClass { get; set; }
}
