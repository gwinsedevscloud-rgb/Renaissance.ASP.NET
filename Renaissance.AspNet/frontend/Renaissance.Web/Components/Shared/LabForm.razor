@using Renaissance.Web.Models

<FormSection Title="Test Details" Icon="bi-droplet-half" IconBgClass="feature-icon-blue">
    <div class="row g-3">
        <div class="col-md-4">
            <FormLabel Text="Test Name" Icon="bi-flask" />
            <InputSelect class="form-select" @bind-Value="_selectedTestName" @bind-Value:after="OnTestChanged">
                <option value="">Select a test...</option>
                @foreach (var test in LaboratoryTestCatalog.Tests)
                {
                    <option value="@test.Name">@test.Name</option>
                }
                <option value="__custom__">Other (custom)</option>
            </InputSelect>
            @if (_selectedTestName == "__custom__")
            {
                <InputText class="form-control mt-2" @bind-Value="Model.TestName" placeholder="Enter custom test name" />
            }
        </div>
        <div class="col-md-4">
            <FormLabel Text="Result" Icon="bi-check2-square" />
            @if (_resultOptions.Count > 0)
            {
                <InputSelect class="form-select" @bind-Value="Model.Result">
                    <option value="">Select result...</option>
                    @foreach (var result in _resultOptions)
                    {
                        <option value="@result">@result</option>
                    }
                </InputSelect>
            }
            else
            {
                <InputText class="form-control" @bind-Value="Model.Result" placeholder="Enter result" />
            }
        </div>
        <div class="col-md-12">
            <FormLabel Text="Note" Icon="bi-journal-text" />
            <InputTextArea class="form-control" rows="3" @bind-Value="Model.Note" />
        </div>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public Laboratory Model { get; set; } = null!;

    private string _selectedTestName = string.Empty;
    private List<string> _resultOptions = [];

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Model.TestName))
        {
            _selectedTestName = string.Empty;
            _resultOptions = [];
            return;
        }

        var known = LaboratoryTestCatalog.FindTest(Model.TestName);
        if (known is null)
        {
            _selectedTestName = "__custom__";
            _resultOptions = [];
            return;
        }

        _selectedTestName = known.Name;
        _resultOptions = known.StandardResults.ToList();
    }

    private void OnTestChanged()
    {
        if (_selectedTestName == "__custom__")
        {
            Model.TestName = string.Empty;
            Model.Result = string.Empty;
            _resultOptions = [];
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedTestName))
        {
            Model.TestName = string.Empty;
            Model.Result = string.Empty;
            Model.Note = string.Empty;
            _resultOptions = [];
            return;
        }

        var test = LaboratoryTestCatalog.FindTest(_selectedTestName);
        if (test is null)
        {
            return;
        }

        Model.TestName = test.Name;
        _resultOptions = test.StandardResults.ToList();
        Model.Result = _resultOptions.FirstOrDefault() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(Model.Note))
        {
            Model.Note = test.DefaultNote;
        }
    }
}
