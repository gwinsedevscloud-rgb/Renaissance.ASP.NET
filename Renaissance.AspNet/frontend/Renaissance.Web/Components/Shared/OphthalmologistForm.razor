@using Renaissance.Web.ViewModels

<FormSection Title="Clinical Assessment" Icon="bi-eye-fill">
    <div class="row g-3">
        <div class="col-md-6"><FormLabel Text="Diagnoses" Icon="bi-search" /><InputTextArea class="form-control" rows="3" @bind-Value="Model.DiagnosesText" /></div>
        <div class="col-md-6"><FormLabel Text="Treatments" Icon="bi-capsule" /><InputTextArea class="form-control" rows="3" @bind-Value="Model.TreatmentsText" /></div>
        <div class="col-md-6"><FormLabel Text="Surgeries" Icon="bi-scissors" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.SurgeriesText" /></div>
        <div class="col-md-6"><FormLabel Text="Other Surgery" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.OtherSurgeryText" /></div>
        <div class="col-md-6"><FormLabel Text="Other Diagnoses" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.OthersDiagnosisText" /></div>
        <div class="col-md-6"><FormLabel Text="Other Treatments" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.OthersTreatmentText" /></div>
    </div>
</FormSection>

<FormSection Title="Vision & Outcomes" Icon="bi-eyeglasses" IconBgClass="feature-icon-blue">
    <div class="row g-3">
        <div class="col-md-3"><FormLabel Text="Visual Acuity (Right)" Icon="bi-eye" /><InputText class="form-control" @bind-Value="Model.VisualAcuityRight" /></div>
        <div class="col-md-3"><FormLabel Text="Visual Acuity (Left)" Icon="bi-eye" /><InputText class="form-control" @bind-Value="Model.VisualAcuityLeft" /></div>
        <div class="col-md-6 d-flex align-items-end gap-3 flex-wrap">
            <div class="checkbox-card flex-fill"><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="Model.GlassesDispensed" /><label class="form-check-label"><i class="bi bi-eyeglasses me-1"></i> Glasses Dispensed</label></div></div>
            <div class="checkbox-card flex-fill"><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="Model.Referred" /><label class="form-check-label"><i class="bi bi-box-arrow-up-right me-1"></i> Referred</label></div></div>
        </div>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public OphthalmologistFormViewModel Model { get; set; } = null!;
}
