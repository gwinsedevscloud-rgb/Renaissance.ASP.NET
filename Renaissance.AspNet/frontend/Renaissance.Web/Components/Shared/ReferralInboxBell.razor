@inject ReferralRealtimeService Realtime
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@implements IDisposable

<div class="referral-inbox-wrap dropdown">
    <button class="btn referral-inbox-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" @onclick="LoadInboxAsync">
        <i class="bi bi-bell"></i>
        @if (_unreadCount > 0)
        {
            <span class="referral-inbox-count">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
        }
    </button>
    <div class="dropdown-menu dropdown-menu-end referral-inbox-menu p-0">
        <div class="referral-inbox-header">
            <strong>Referrals</strong>
            @if (_items.Count > 0)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="MarkAllReadAsync">Mark all read</button>
            }
        </div>
        @if (_loading)
        {
            <div class="p-3 text-muted small">Loading…</div>
        }
        else if (_items.Count == 0)
        {
            <div class="p-3 text-muted small">No recent referrals for your modules.</div>
        }
        else
        {
            <div class="referral-inbox-list">
                @foreach (var item in _items.Take(12))
                {
                    <button type="button" class="referral-inbox-item @(item.IsRead ? "" : "unread")" @onclick="() => OpenItemAsync(item)">
                        <div class="d-flex justify-content-between gap-2">
                            <strong>@item.PatientFullName</strong>
                            <span class="referral-priority-chip @ReferralDisplayHelper.PriorityClass(item.Priority)">
                                @ReferralDisplayHelper.PriorityLabel(item.Priority)
                            </span>
                        </div>
                        <small class="text-muted d-block">@ModuleNav.DisplayName(item.SourceModule) → @ModuleNav.DisplayName(item.TargetModule)</small>
                        <small class="@(item.Status == ReferralStatus.Pending ? "text-teal" : "text-muted")">
                            @ReferralDisplayHelper.StatusLabel(item.Status) · @ReferralDisplayHelper.WaitLabel(item.WaitMinutes)
                        </small>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private List<ReferralInboxItem> _items = [];
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        Realtime.ReferralReceived += OnReferralReceived;
        Realtime.ModuleCountsChanged += OnCountsChanged;
        await Realtime.EnsureConnectedAsync();
        await LoadInboxAsync();
    }

    private async void OnReferralReceived(ReferralNotification _)
    {
        await InvokeAsync(async () => { await LoadInboxAsync(); StateHasChanged(); });
    }

    private async void OnCountsChanged()
    {
        await InvokeAsync(async () => { await LoadInboxAsync(); StateHasChanged(); });
    }

    private async Task LoadInboxAsync()
    {
        if (!Auth.IsAuthenticated) return;
        _loading = _items.Count == 0;
        _items = await Api.GetReferralInboxAsync();
        _unreadCount = _items.Count(i => !i.IsRead && i.Status is ReferralStatus.Pending or ReferralStatus.InProgress);
        _loading = false;
    }

    private async Task OpenItemAsync(ReferralInboxItem item)
    {
        await Api.MarkReferralReadAsync(item.ReferralId);
        var href = ModuleNav.Clinical.FirstOrDefault(m => m.Module == item.TargetModule)?.Href ?? "/";
        Nav.NavigateTo(href);
    }

    private async Task MarkAllReadAsync()
    {
        await Api.MarkAllReferralsReadAsync();
        await LoadInboxAsync();
    }

    public void Dispose()
    {
        Realtime.ReferralReceived -= OnReferralReceived;
        Realtime.ModuleCountsChanged -= OnCountsChanged;
    }
}
