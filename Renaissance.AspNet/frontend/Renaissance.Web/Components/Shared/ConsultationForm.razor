@using Renaissance.Web.ViewModels

<FormSection Title="Clinical Assessment" Icon="bi-clipboard2-pulse">
    <div class="row g-3">
        <div class="col-md-6"><FormLabel Text="Diagnoses" Icon="bi-search" /><InputTextArea class="form-control" rows="3" @bind-Value="Model.DiagnosesText" /><div class="form-hint">One per line or comma-separated</div></div>
        <div class="col-md-6"><FormLabel Text="Treatments" Icon="bi-capsule" /><InputTextArea class="form-control" rows="3" @bind-Value="Model.TreatmentsText" /></div>
        <div class="col-md-6"><FormLabel Text="Other Diagnoses" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.OthersDiagnosisText" /></div>
        <div class="col-md-6"><FormLabel Text="Other Treatments" /><InputTextArea class="form-control" rows="2" @bind-Value="Model.OthersTreatmentText" /></div>
    </div>
</FormSection>

<FormSection Title="Referrals & ITN"
             Icon="bi-arrow-right-circle"
             IconBgClass="feature-icon-blue"
             Collapsible
             InitiallyExpanded="@HasReferralContent"
             CollapsedHint="Expand to add referrals or ITN tasks">
    <div class="row g-3">
        <div class="col-md-6">
            <FormLabel Text="Services Referred" Icon="bi-send" />
            <InputTextArea class="form-control" rows="2" @bind-Value="Model.ServicesReferredText" placeholder="e.g. Laboratory, Dental…" />
            <div class="form-hint">Document services; use <strong>Referred</strong> below to route via the live queue.</div>
        </div>
        <div class="col-md-6 d-flex align-items-stretch gap-3 flex-wrap">
            <div class="checkbox-card flex-fill consultation-flag-card">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.Referred" />
                    <label class="form-check-label"><i class="bi bi-box-arrow-up-right me-1"></i> Referred</label>
                </div>
                <small class="consultation-flag-hint">Opens referral prompt after save to send patient to other modules.</small>
            </div>
            <div class="checkbox-card flex-fill consultation-flag-card">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.ItnOrder" />
                    <label class="form-check-label"><i class="bi bi-bag-plus me-1"></i> ITN Ordered</label>
                </div>
                <small class="consultation-flag-hint">Creates a pending ITN task in pharmacy and adds patient to pharmacy queue.</small>
            </div>
            <div class="checkbox-card flex-fill consultation-flag-card">
                <div class="form-check">
                    <InputCheckbox class="form-check-input" @bind-Value="Model.ItnDispense" />
                    <label class="form-check-label"><i class="bi bi-bag-check me-1"></i> ITN Dispensed</label>
                </div>
                <small class="consultation-flag-hint">Marks the ITN pharmacy task as dispensed and clears the pharmacy referral.</small>
            </div>
        </div>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public ConsultationFormViewModel Model { get; set; } = null!;

    private bool HasReferralContent =>
        Model.Referred
        || Model.ItnOrder
        || Model.ItnDispense
        || !string.IsNullOrWhiteSpace(Model.ServicesReferredText);
}
