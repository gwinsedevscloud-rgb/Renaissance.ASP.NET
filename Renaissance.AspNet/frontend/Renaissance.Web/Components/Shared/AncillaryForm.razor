@using Renaissance.Web.ViewModels

<FormSection Title="Service Details" Icon="bi-bandaid">
    <div class="row g-3">
        <div class="col-md-8">
            <FormLabel Text="Services" Icon="bi-list-check" />
            <InputTextArea class="form-control" rows="3" @bind-Value="Model.ServicesText" />
            <div class="form-hint">One per line or comma-separated</div>
        </div>
        <div class="col-md-4">
            <FormLabel Text="Pregnancy Status" Icon="bi-heart" />
            <InputText class="form-control" @bind-Value="Model.PregnancyStatus" />
        </div>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public AncillaryFormViewModel Model { get; set; } = null!;
}
