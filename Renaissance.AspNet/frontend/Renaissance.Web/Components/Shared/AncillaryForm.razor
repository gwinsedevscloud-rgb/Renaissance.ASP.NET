@using Renaissance.Web.ViewModels

<FormSection Title="Service Details" Icon="bi-bandaid">
    <div class="row g-3">
        <div class="col-md-8">
            <CatalogTextPicker Label="Services"
                               Icon="bi-list-check"
                               Options="ClinicalCatalog.AncillaryServices"
                               @bind-Value="Model.ServicesText" />
        </div>
        <div class="col-md-4">
            <FormLabel Text="Pregnancy Status" Icon="bi-heart" />
            <InputSelect class="form-select" @bind-Value="Model.PregnancyStatus">
                <option value="">Select status…</option>
                @foreach (var status in ClinicalCatalog.PregnancyStatuses)
                {
                    <option value="@status">@status</option>
                }
            </InputSelect>
        </div>
    </div>
</FormSection>

@code {
    [Parameter, EditorRequired]
    public AncillaryFormViewModel Model { get; set; } = null!;
}
