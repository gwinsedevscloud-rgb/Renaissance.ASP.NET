@inject RenaissanceApiClient Api
@implements IDisposable

<div class="quick-search-card">
    <div class="quick-search-inline">
        <label class="quick-search-leading" for="@_inputId">
            <span class="quick-search-leading-icon"><i class="bi bi-person-search"></i></span>
            <span class="quick-search-leading-text">Search for a Patient</span>
        </label>
        <div class="quick-search-field">
            <input id="@_inputId"
                   class="quick-search-input"
                   @bind="_search"
                   @bind:event="oninput"
                   @bind:after="OnSearchInputAsync"
                   placeholder="Number, phone, or name..." />
            @if (_searching)
            {
                <span class="quick-search-spinner" role="status" aria-label="Searching">
                    <span class="spinner-border spinner-border-sm text-muted"></span>
                </span>
            }
        </div>
    </div>

    @if (_searched && _matches.Count == 0)
    {
        <p class="quick-search-empty mb-0">No matching patients. Register a patient first if you have access.</p>
    }
    else if (_matches.Count > 0)
    {
        <div class="quick-search-results">
            @foreach (var p in _matches)
            {
                <div class="quick-search-row">
                    <ClientIdentity Patient="p" />
                    <a class="btn btn-sm btn-primary" href="@($"{CreateHrefPrefix}/{p.Id}")">@ActionLabel</a>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly string _inputId = $"patient-search-{Guid.NewGuid():N}";

    [Parameter, EditorRequired]
    public string CreateHrefPrefix { get; set; } = string.Empty;

    [Parameter]
    public string ActionLabel { get; set; } = "Open";

    private string? _search;
    private bool _searched;
    private bool _searching;
    private List<Patient> _matches = [];
    private CancellationTokenSource? _debounceCts;
    private int _searchGeneration;

    private async Task OnSearchInputAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _debounceCts?.Cancel();
            _searched = false;
            _searching = false;
            _matches = [];
            return;
        }

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;
        var generation = ++_searchGeneration;

        _searching = true;
        try
        {
            await Task.Delay(300, token);
            await SearchAsync();
        }
        catch (TaskCanceledException)
        {
            return;
        }
        finally
        {
            if (generation == _searchGeneration)
            {
                _searching = false;
            }
        }
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_search))
        {
            _searched = false;
            _matches = [];
            return;
        }

        _searched = true;
        var all = await Api.GetPatientsAsync(_search);
        _matches = all.Take(8).ToList();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
