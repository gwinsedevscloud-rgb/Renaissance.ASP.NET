@page "/patients/details/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Client Details - Renaissance</PageTitle>

@if (_loading)
{
    <LoadingState />
}
else if (_patient is null)
{
    <EmptyPanel Icon="bi-exclamation-circle" Title="Client not found" Message="This client may have been archived or the link is invalid.">
        <a class="btn btn-primary" href="/patients">All Clients</a>
    </EmptyPanel>
}
else
{
    <div class="patient-hero mb-4">
        <div class="d-flex gap-3 align-items-start">
            <div class="patient-hero-avatar">@ClientDisplayHelper.Initials(_patient)</div>
            <div>
                <h1 class="h3 mb-1">@ClientDisplayHelper.DisplayName(_patient)</h1>
                <div class="client-number mb-1">@_patient.ClientNumber</div>
                <div class="patient-meta">
                    <span class="patient-meta-item"><i class="bi bi-calendar3"></i> @_patient.Age @_patient.AgeUnit</span>
                    <span class="patient-meta-item"><i class="bi bi-gender-ambiguous"></i> @_patient.Sex</span>
                    @if (!string.IsNullOrEmpty(_patient.PhoneNumber))
                    {
                        <span class="patient-meta-item"><i class="bi bi-telephone"></i> @_patient.PhoneNumber</span>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-primary" href="/client-dashboard/@_patient.Id">
                <i class="bi bi-grid-1x2 me-1"></i> Dashboard
            </a>
            <a class="btn btn-outline-primary" href="/patients/edit/@_patient.Id">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
            <a class="btn btn-outline-secondary" href="/patients">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="section-card">
        <div class="section-card-header">
            <span class="section-icon feature-icon-blue"><i class="bi bi-card-text"></i></span>
            <h2>Demographics</h2>
        </div>
        <dl class="row mb-0 detail-grid">
            <dt class="col-sm-3 text-muted">Marital Status</dt><dd class="col-sm-9">@(_patient.MaritalStatus ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Tribe</dt><dd class="col-sm-9">@(_patient.Tribe ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Religion</dt><dd class="col-sm-9">@(_patient.Religion ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Occupation</dt><dd class="col-sm-9">@(_patient.Occupation ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Education</dt><dd class="col-sm-9">@(_patient.Education ?? "—")</dd>
            <dt class="col-sm-3 text-muted">Address</dt><dd class="col-sm-9">@(_patient.Address ?? "—")</dd>
        </dl>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Patient? _patient;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(Id);
        _loading = false;
    }
}
