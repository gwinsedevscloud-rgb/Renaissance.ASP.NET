@page "/laboratory/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Laboratory - MedReach</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div> }
else
{
    <PageHeader Title="New Laboratory Record" Icon="bi-droplet-half" IconBgClass="feature-icon-blue"
                Subtitle="Choose up to two tests and enter results" />
    <EditForm Model="_formAnchor" OnValidSubmit="SaveAsync" class="form-card">
        <LabForm @ref="_labForm" DualTests="true" />
        <FormActions SaveLabel="Save record"
                     SaveIcon="bi-droplet"
                     CancelHref="@($"/patient-dashboard/{PatientId}")"
                     Saving="_saving"
                     ShowReferAfterSave="true"
                     OnReferAfterSave="SaveAndReferAsync" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferral"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the patient")"
                         SourceModule="AppModule.Laboratory"
                         SourceRecordId="_savedId"
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferral;
    private Guid? _savedId;
    private LabForm? _labForm;
    private readonly LabCreateAnchor _formAnchor = new();

    private sealed class LabCreateAnchor { }

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (!await PersistAsync()) return;
            Notifications.ShowSuccess("Laboratory record(s) saved.");
            Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        }
        finally { _saving = false; }
    }

    private async Task SaveAndReferAsync()
    {
        _saving = true;
        try
        {
            if (!await PersistAsync()) return;
            Notifications.ShowSuccess("Laboratory record(s) saved. Select modules to refer the patient to.");
            _showReferral = true;
        }
        finally { _saving = false; }
    }

    private async Task<bool> PersistAsync()
    {
        if (_labForm is null) return false;

        if (!_labForm.TryBuildRecords(PatientId, out var records, out _))
        {
            return false;
        }

        Guid? lastId = null;
        foreach (var record in records)
        {
            await Api.CreateLaboratoryAsync(record);
            lastId = record.Id;
        }

        _savedId = lastId;
        return true;
    }

    private Task FinishAsync()
    {
        _showReferral = false;
        Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        return Task.CompletedTask;
    }
}
