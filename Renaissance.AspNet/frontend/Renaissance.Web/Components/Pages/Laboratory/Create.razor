@page "/laboratory/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Laboratory - Renaissance</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Client not found.</div> }
else
{
    <PageHeader Title="New Laboratory Record" Icon="bi-droplet-half" IconBgClass="feature-icon-blue" />
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card">
        <LabForm Model="_model" />
        <FormActions SaveLabel="Save Record" SaveIcon="bi-droplet" CancelHref="@($"/client-dashboard/{PatientId}")" Saving="_saving" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferral" PatientId="PatientId" PatientName="@(_patient?.FullName ?? "the client")"
                         SourceModule="AppModule.Laboratory" SourceRecordId="_savedId" OnSkipped="FinishAsync" OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Laboratory _model = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferral;
    private Guid? _savedId;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _model.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        if (_model.Id == Guid.Empty) _model.Id = Guid.NewGuid();
        try
        {
            await Api.CreateLaboratoryAsync(_model);
            _savedId = _model.Id;
            Notifications.ShowSuccess("Laboratory record saved.");
            _showReferral = true;
        }
        finally { _saving = false; }
    }

    private Task FinishAsync() { _showReferral = false; Nav.NavigateTo($"/client-dashboard/{PatientId}"); return Task.CompletedTask; }
}
