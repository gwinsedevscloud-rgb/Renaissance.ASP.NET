@page "/laboratory"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Laboratory - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Laboratory" Subtitle="Record tests and results" Icon="bi-droplet-half" IconBgClass="feature-icon-blue" />

    <ReferralQueuePanel Module="AppModule.Laboratory" />

    <PatientQuickSearch CreateHrefPrefix="/laboratory/create" ActionLabel="New test" />

    @if (_loading)
    {
        <LoadingState Message="Loading laboratory records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-droplet-half" Title="No laboratory records yet" Message="Search for a patient above to record a test." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>

        <div class="module-mobile-list d-md-none">
            @foreach (var l in _items)
            {
                <ModuleMobileCard Patient="Patient(l.PatientId)"
                                  Primary="@(l.TestName ?? "—")"
                                  Secondary="@(string.IsNullOrWhiteSpace(l.Result) ? "Result pending" : $"Result: {l.Result}")"
                                  Date="l.CreatedDate"
                                  Href="@($"/laboratory/edit/{l.Id}")"
                                  Title="Edit test"
                                  Icon="bi-pencil" />
            }
        </div>

        <div class="section-card table-card p-0 d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-laboratory">
                    <ModuleRecordColGroup Widths="@(new[] { "24%", "28%", "18%", "16%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Test" Icon="bi-droplet-half" />
                            <ModuleTableTh Label="Result" Icon="bi-clipboard2-data" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var l in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(l.PatientId)" /></td>
                            <td><span class="record-field"><i class="bi bi-droplet-half"></i>@(l.TestName ?? "—")</span></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(l.Result))
                                {
                                    <span class="record-chip"><i class="bi bi-hourglass-split"></i>Pending</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-clipboard2-check"></i>@l.Result</span>
                                }
                            </td>
                            <ModuleRecordDate Value="l.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/laboratory/edit/{l.Id}")" Title="Edit test" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Laboratory> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetLaboratoriesAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
