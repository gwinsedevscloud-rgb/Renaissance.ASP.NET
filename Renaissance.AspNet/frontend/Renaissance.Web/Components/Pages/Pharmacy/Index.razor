@page "/pharmacy"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Pharmacy - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Pharmacy" Subtitle="Prescribe medications and dispense pending orders" Icon="bi-capsule" IconBgClass="feature-icon-violet" />

    <ReferralQueuePanel Module="AppModule.Pharmacy" />

    <PatientQuickSearch CreateHrefPrefix="/pharmacy/create" ActionLabel="Prescribe" />

    @if (_pendingItnCount > 0)
    {
        <div class="record-meta mb-2">
            <span class="module-chip"><i class="bi bi-bag-plus me-1"></i>@_pendingItnCount pending ITN order@(_pendingItnCount == 1 ? "" : "s") in queue</span>
        </div>
    }

    @if (_loading)
    {
        <LoadingState Message="Loading prescriptions..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-capsule" Title="No prescriptions yet" Message="Search for a patient above to prescribe medication." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>

        <div class="module-mobile-list d-md-none">
            @foreach (var p in _items)
            {
                var isPendingItn = p.DrugCategory == "ITN" && p.Status == DispensationStatus.PENDING;
                <ModuleMobileCard Patient="Patient(p.PatientId)"
                                  Primary="@(p.DrugName ?? "—")"
                                  Secondary="@(string.IsNullOrWhiteSpace(p.Dosage) ? p.Status.ToString() : $"{p.Dosage} · {p.Status}")"
                                  Date="p.CreatedDate"
                                  Href="@($"/pharmacy/dispense/{p.PatientId}")"
                                  Title="Dispense"
                                  Icon="bi-check2-all"
                                  Label="Dispense">
                    @if (isPendingItn)
                    {
                        <span class="record-chip mt-1"><i class="bi bi-bag-plus"></i>ITN queue</span>
                    }
                </ModuleMobileCard>
            }
        </div>

        <div class="section-card table-card p-0 d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-pharmacy">
                    <ModuleRecordColGroup Widths="@(new[] { "24%", "30%", "16%", "16%", "7.25rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Drug" Icon="bi-capsule" />
                            <ModuleTableTh Label="Status" Icon="bi-check2-circle" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in _items)
                    {
                        var isPendingItn = p.DrugCategory == "ITN" && p.Status == DispensationStatus.PENDING;
                        <tr class="@(isPendingItn ? "table-warning-subtle" : null)">
                            <td><ClientIdentity Patient="Patient(p.PatientId)" /></td>
                            <td>
                                <span class="record-field">
                                    <i class="bi bi-capsule"></i>
                                    @(p.DrugName ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(p.Dosage))
                                    {
                                        <span class="record-field-muted">@p.Dosage</span>
                                    }
                                </span>
                                @if (isPendingItn)
                                {
                                    <span class="record-chip ms-1"><i class="bi bi-bag-plus"></i>ITN queue</span>
                                }
                            </td>
                            <td><StatusBadge Status="p.Status" /></td>
                            <ModuleRecordDate Value="p.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/pharmacy/dispense/{p.PatientId}")" Title="Dispense" Icon="bi-check2-all" Label="Dispense" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private int _pendingItnCount;
    private List<PharmacyPrescription> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        var all = await Api.GetPharmacyPrescriptionsAsync();
        _pendingItnCount = all.Count(p => p.DrugCategory == "ITN" && p.Status == DispensationStatus.PENDING);
        _items = all
            .OrderByDescending(p => p.DrugCategory == "ITN" && p.Status == DispensationStatus.PENDING)
            .ThenByDescending(p => p.CreatedDate)
            .Take(50)
            .ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
