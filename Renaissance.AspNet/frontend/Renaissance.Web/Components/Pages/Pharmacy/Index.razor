@page "/pharmacy"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Pharmacy - Renaissance</PageTitle>

<div class="module-page">
    <PageHeader Title="Pharmacy" Subtitle="Prescribe medications and dispense pending orders" Icon="bi-capsule" IconBgClass="feature-icon-violet" />

    <ReferralQueuePanel Module="AppModule.Pharmacy" />

    <PatientQuickSearch CreateHrefPrefix="/pharmacy/create" ActionLabel="Prescribe" />

    @if (_loading)
    {
        <LoadingState Message="Loading prescriptions..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-capsule" Title="No prescriptions yet" Message="Search for a client above to prescribe medication." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>
        <div class="section-card table-card p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Client</th>
                            <th>Drug</th>
                            <th>Status</th>
                            <th class="d-none d-sm-table-cell">Recorded</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(p.PatientId)" /></td>
                            <td>@(p.DrugName ?? "—") <small class="text-muted">@p.Dosage</small></td>
                            <td><StatusBadge Status="p.Status" /></td>
                            <td class="d-none d-sm-table-cell"><small class="text-muted">@(p.CreatedDate?.ToLocalTime().ToString("g") ?? "—")</small></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="/pharmacy/dispense/@p.PatientId">Dispense</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<PharmacyPrescription> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetPharmacyPrescriptionsAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
