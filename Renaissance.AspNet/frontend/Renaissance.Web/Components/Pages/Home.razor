@page "/"
@rendermode InteractiveServer
@inject AuthStateService Auth
@inject ReferralRealtimeService Referrals
@inject RenaissanceApiClient Api
@inject OutreachStateService Outreach
@implements IDisposable

<PageTitle>Home - MedReach</PageTitle>

<div class="home-dashboard">
    <div class="hero-panel home-hero mb-3">
        <div class="home-hero-glow home-hero-glow-light" aria-hidden="true"></div>
        <div class="home-hero-grid" aria-hidden="true"></div>

        <div class="position-relative home-hero-layout">
            <div class="home-hero-content">
                <div class="home-hero-intro-block">
                    <span class="home-hero-accent" aria-hidden="true"></span>
                    <h1 class="home-hero-title mb-1">
                        <i class="bi bi-heart-pulse me-2"></i>MedReach
                    </h1>
                    <p class="lead mb-1">
                        Welcome back, @(Auth.User?.FullName ?? "colleague").
                    </p>
                    <p class="home-hero-subtext mb-0">
                        Signed in as <strong>@Auth.User?.RoleName</strong>. You have access to
                        <strong>@ModuleCount module@(ModuleCount == 1 ? "" : "s")</strong>
                        tailored to your role at @(string.IsNullOrWhiteSpace(_facilityName) ? "this facility" : _facilityName).
                    </p>
                </div>

                <div class="home-hero-actions">
                    @if (Auth.HasModule(AppModule.Clients))
                    {
                        <a class="btn btn-light-hero" href="/patients">
                            <i class="bi bi-people-fill me-2"></i>Open Patients
                        </a>
                    }
                    @if (Auth.HasModule(AppModule.Stakeholders))
                    {
                        <a class="btn btn-outline-light home-hero-btn-outline" href="/stakeholders">
                            <i class="bi bi-graph-up-arrow me-2"></i>Stakeholders Dashboard
                        </a>
                    }
                </div>
            </div>

            <aside class="home-hero-aside">
                <dl class="home-hero-stats">
                    <div class="home-hero-stat">
                        <dt>Modules</dt>
                        <dd>@ModuleCount</dd>
                    </div>
                    <div class="home-hero-stat home-hero-stat-queue @(TotalPending > 0 ? "has-pending" : "")">
                        <dt>
                            <i class="bi bi-bell@(TotalPending > 0 ? "-fill" : "") home-hero-queue-bell" aria-hidden="true"></i>
                            Queue
                        </dt>
                        <dd class="home-hero-queue-value">
                            <span>@TotalPending</span>
                            @if (TotalPending > 0)
                            {
                                <span class="home-hero-queue-badge" aria-hidden="true">@TotalPending</span>
                            }
                        </dd>

                        <div class="home-hero-queue-popover" role="tooltip">
                            @if (PendingModules.Count == 0)
                            {
                                <div class="home-hero-queue-empty">
                                    <i class="bi bi-check-circle-fill"></i>
                                    No referrals waiting
                                </div>
                            }
                            else
                            {
                                <div class="home-hero-queue-popover-title">Waiting for you</div>
                                <ul class="home-hero-queue-popover-list">
                                    @foreach (var item in PendingModules)
                                    {
                                        var count = Referrals.GetPendingCount(item.Module);
                                        <li>
                                            <a href="@item.Href">
                                                <span class="home-hero-queue-popover-mod">
                                                    <i class="bi @item.Icon"></i>
                                                    @item.Label
                                                </span>
                                                <span class="home-hero-queue-popover-count">@count</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </dl>

                <div class="home-hero-meta">
                    @if (!string.IsNullOrWhiteSpace(_facilityName))
                    {
                        <span class="home-hero-meta-item">
                            <i class="bi bi-hospital"></i>
                            <span>@_facilityName</span>
                        </span>
                    }
                    else
                    {
                        <span class="home-hero-meta-item">
                            <i class="bi bi-hospital"></i>
                            <span>MedReach</span>
                        </span>
                    }
                    <span class="home-hero-meta-item">
                        <i class="bi bi-calendar3"></i>
                        <span>@DateTime.Now.ToString("dddd, d MMM yyyy")</span>
                    </span>
                </div>
            </aside>
        </div>
    </div>

    @if (_accessibleSecondary.Count > 0)
    {
        <div class="home-modules-section mt-2">
            <div class="home-modules-header">
                <div class="home-modules-heading">
                    <span class="home-modules-eyebrow">Concurrent outreach</span>
                </div>
            </div>
            <div class="home-secondary-grid">
                @for (var i = 0; i < _accessibleSecondary.Count; i++)
                {
                    var program = _accessibleSecondary[i];
                    var accent = SecondaryAccentClass(program);
                    var icon = SecondaryIcon(program);
                    var href = SecondaryHref(program);
                    var kind = program.IsClinicLinked || program.LinkedClinicalModule.HasValue
                        ? "Clinic referrals"
                        : "Registration only";
                    <a class="home-secondary-card @accent text-decoration-none"
                       href="@href"
                       style="--home-stagger: @i">
                        <span class="home-secondary-shine" aria-hidden="true"></span>
                        <span class="home-secondary-stripe" aria-hidden="true"></span>
                        <div class="home-secondary-top">
                            <span class="home-secondary-icon" aria-hidden="true">
                                <i class="bi @icon"></i>
                            </span>
                            <span class="home-secondary-count">@program.RegisteredCount</span>
                        </div>
                        <div class="home-secondary-body">
                            <h3 class="home-secondary-name">@program.Name</h3>
                            <p class="home-secondary-meta">@program.RegisteredCount registered · @kind</p>
                        </div>
                        <span class="home-secondary-go" aria-hidden="true">
                            <i class="bi bi-arrow-right"></i>
                        </span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Outreach.IsOutreachMode && Outreach.ActiveProgram is not null)
    {
        var program = Outreach.ActiveProgram;
        <div class="home-outreach-banner d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <div>
                <strong><i class="bi bi-megaphone me-1"></i> Outreach mode:</strong> @program.Name
                <span class="text-muted ms-2">@program.StartDate.ToString("d MMM") – @program.EndDate.ToString("d MMM yyyy")</span>
            </div>
            <div class="small">
                Registered <strong>@program.RegisteredCount</strong>@if (program.BatchSize is not null) { <text> / @program.BatchSize</text> }
                · Flow: Registration → Triage → Lab → Consultation → Pharmacy
            </div>
        </div>
    }

    @{
        var allModules = ModuleNav.All
            .Where(m => Auth.HasModule(m.Module) && m.Module != AppModule.ClientDashboard);
        var modules = Outreach.FilterModules(allModules).ToList();
    }

    @if (modules.Count > 0)
    {
        <div class="home-modules-section">
            <div class="home-modules-header">
                <div class="home-modules-heading">
                    <span class="home-modules-eyebrow">Clinical workspace</span>
                </div>
                <span class="home-modules-count">@modules.Count module@(modules.Count == 1 ? "" : "s")</span>
            </div>

            <div class="row g-2 g-md-3 home-module-grid">
                @for (var i = 0; i < modules.Count; i++)
                {
                    var item = modules[i];
                    var accent = ModuleAccentClass(item.Module);
                    var pending = Referrals.GetPendingCount(item.Module);

                    <div class="col-md-4 col-lg-3 home-module-col" style="--home-stagger: @i">
                        <a class="home-module-card @accent text-decoration-none d-block h-100" href="@item.Href">
                            <span class="home-module-stripe" aria-hidden="true"></span>

                            <div class="home-module-top">
                                <div class="home-module-icon @accent">
                                    <i class="bi @item.Icon"></i>
                                </div>
                                @if (pending > 0)
                                {
                                    <span class="home-module-status home-module-status-pending" title="@pending pending">
                                        <i class="bi bi-inbox-fill"></i> @pending
                                    </span>
                                }
                                else
                                {
                                    <span class="home-module-status home-module-status-ready">
                                        <i class="bi bi-check2"></i> Ready
                                    </span>
                                }
                            </div>

                            <div class="home-module-body">
                                <h2 class="home-module-name">@item.Label</h2>
                                <p class="home-module-desc">@item.Description</p>
                            </div>

                            <span class="home-module-go" aria-hidden="true">
                                <i class="bi bi-arrow-right"></i>
                            </span>
                        </a>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private string? _facilityName;
    private List<CareProgramSummaryDto> _accessibleSecondary = [];

    protected override async Task OnInitializedAsync()
    {
        Referrals.ModuleCountsChanged += OnCountsChanged;
        Outreach.Changed += OnOutreachChanged;
        await Referrals.EnsureConnectedAsync();

        try
        {
            _accessibleSecondary = await Api.GetAccessibleSecondaryProgramsAsync();
        }
        catch
        {
            _accessibleSecondary = [];
        }

        try
        {
            var settings = await Api.GetPublicSettingsAsync();
            _facilityName = settings?.FacilityName;
        }
        catch
        {
            _facilityName = null;
        }
    }

    private void OnCountsChanged() => InvokeAsync(StateHasChanged);

    private void OnOutreachChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Referrals.ModuleCountsChanged -= OnCountsChanged;
        Outreach.Changed -= OnOutreachChanged;
    }

    private int ModuleCount =>
        Outreach.FilterModules(ModuleNav.All.Where(m => Auth.HasModule(m.Module) && m.Module != AppModule.ClientDashboard)).Count();

    private int TotalPending =>
        ModuleNav.All.Where(m => Auth.HasModule(m.Module)).Sum(m => Referrals.GetPendingCount(m.Module));

    private List<ModuleNavItem> PendingModules =>
        Outreach.FilterModules(ModuleNav.All.Where(m => Auth.HasModule(m.Module) && Referrals.GetPendingCount(m.Module) > 0))
            .OrderByDescending(m => Referrals.GetPendingCount(m.Module))
            .ToList();

    private static string ModuleAccentClass(AppModule module) => module switch
    {
        AppModule.Clients => "home-accent-teal",
        AppModule.Triage => "home-accent-coral",
        AppModule.Consultations => "home-accent-slate",
        AppModule.Pharmacy => "home-accent-indigo",
        AppModule.Laboratory => "home-accent-sky",
        AppModule.Dental => "home-accent-amber",
        AppModule.Ancillary => "home-accent-rose",
        AppModule.Optometrists => "home-accent-violet",
        AppModule.Ophthalmologists => "home-accent-emerald",
        AppModule.Stakeholders => "home-accent-gold",
        AppModule.Administration => "home-accent-charcoal",
        _ => "home-accent-teal"
    };

    private static string SecondaryIcon(CareProgramSummaryDto program) => program.LinkedClinicalModule switch
    {
        AppModule.Dental => "bi-emoji-smile",
        AppModule.Optometrists => "bi-eye",
        _ when program.Name.Contains("ITN", StringComparison.OrdinalIgnoreCase)
              || program.Name.Contains("Insecticide", StringComparison.OrdinalIgnoreCase)
            => "bi-shield-check",
        _ => "bi-droplet"
    };

    private static string SecondaryAccentClass(CareProgramSummaryDto program) => program.LinkedClinicalModule switch
    {
        AppModule.Dental => "home-secondary-dental",
        AppModule.Optometrists => "home-secondary-eye",
        _ when program.Name.Contains("ITN", StringComparison.OrdinalIgnoreCase)
              || program.Name.Contains("Insecticide", StringComparison.OrdinalIgnoreCase)
            => "home-secondary-itn",
        _ => "home-secondary-deworm"
    };

    private static string SecondaryHref(CareProgramSummaryDto program) => program.LinkedClinicalModule switch
    {
        AppModule.Dental => "/dental",
        AppModule.Optometrists => "/optometrists",
        _ => $"/secondary-outreach/register/{program.Id}"
    };
}
