@page "/"
@rendermode InteractiveServer
@inject AuthStateService Auth

<PageTitle>Home - Renaissance</PageTitle>

<div class="hero-panel mb-4">
    <div class="position-relative">
        <h1 class="display-5 mb-3">
            <i class="bi bi-heart-pulse me-2"></i>Renaissance
        </h1>
        <p class="lead mb-2">
            Welcome back, @(Auth.User?.FullName ?? "colleague").
        </p>
        <p class="mb-4 opacity-75">
            Signed in as <strong>@Auth.User?.RoleName</strong>. Open only the modules assigned to your role.
        </p>
        @if (Auth.HasModule(AppModule.Clients))
        {
            <a class="btn btn-light-hero btn-lg me-2" href="/patients">
                <i class="bi bi-people-fill me-2"></i>Open Clients
            </a>
        }
        @if (Auth.HasModule(AppModule.Stakeholders))
        {
            <a class="btn btn-outline-light btn-lg" href="/stakeholders">
                <i class="bi bi-graph-up-arrow me-2"></i>Stakeholders Dashboard
            </a>
        }
    </div>
</div>

<div class="row g-3">
    @foreach (var item in ModuleNav.All.Where(m => Auth.HasModule(m.Module) && m.Module != AppModule.ClientDashboard))
    {
        <div class="col-md-4 col-lg-3">
            <a class="feature-card text-decoration-none d-block h-100" href="@item.Href">
                <div class="feature-icon feature-icon-teal"><i class="bi @item.Icon"></i></div>
                <h2 class="h5 fw-semibold">@item.Label</h2>
                <p class="text-muted mb-0">@item.Description</p>
            </a>
        </div>
    }
</div>
