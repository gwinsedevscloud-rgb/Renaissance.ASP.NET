@page "/consultations/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Consultation - Renaissance</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div> }
else
{
    <PageHeader Title="New Consultation" Subtitle="Record diagnosis, treatment, and optional referrals" Icon="bi-clipboard2-pulse" IconBgClass="feature-icon-blue" />
    <EditForm Model="_vm" OnValidSubmit="SaveAsync" class="form-card">
        <ConsultationForm Model="_vm" />
        <FormActions SaveLabel="Save consultation"
                     SaveIcon="bi-clipboard2-check"
                     CancelHref="@($"/patient-dashboard/{PatientId}")"
                     Saving="_saving"
                     ShowReferAfterSave="true"
                     OnReferAfterSave="SaveAndReferAsync" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferral"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the patient")"
                         SourceModule="AppModule.Consultations"
                         SourceRecordId="_savedId"
                         Subtitle="Select one or more modules — referral is optional."
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private ConsultationFormViewModel _vm = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferral;
    private Guid? _savedId;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _vm.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess(BuildSaveMessage());
            Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        }
        finally { _saving = false; }
    }

    private async Task SaveAndReferAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess("Consultation saved. Select modules to refer the patient to.");
            _showReferral = true;
        }
        finally { _saving = false; }
    }

    private async Task PersistAsync()
    {
        var entity = Map(_vm);
        entity.Id = Guid.NewGuid();
        entity.Referred = false;
        await Api.CreateConsultationAsync(entity);
        _savedId = entity.Id;
    }

    private string BuildSaveMessage()
    {
        var parts = new List<string> { "Consultation saved." };
        if (_vm.ItnOrder) parts.Add("ITN added to pharmacy queue.");
        if (_vm.ItnDispense) parts.Add("ITN marked dispensed.");
        return string.Join(" ", parts);
    }

    private Task FinishAsync() { _showReferral = false; Nav.NavigateTo($"/patient-dashboard/{PatientId}"); return Task.CompletedTask; }

    private static Consultation Map(ConsultationFormViewModel vm) => new()
    {
        PatientId = vm.PatientId,
        Diagnoses = ListTextHelper.FromMultiline(vm.DiagnosesText),
        Treatments = ListTextHelper.FromMultiline(vm.TreatmentsText),
        ServicesReferred = ListTextHelper.FromMultiline(vm.ServicesReferredText),
        Referred = false,
        ItnOrder = vm.ItnOrder,
        ItnDispense = vm.ItnDispense,
        OthersDiagnosis = ListTextHelper.FromMultiline(vm.OthersDiagnosisText),
        OthersTreatment = ListTextHelper.FromMultiline(vm.OthersTreatmentText)
    };
}
