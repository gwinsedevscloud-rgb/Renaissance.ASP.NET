@page "/consultations/edit/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Edit Consultation - Renaissance</PageTitle>

@if (_loading) { <LoadingState /> }
else if (_vm is null) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Consultation not found.</div> }
else
{
    <PageHeader Title="Edit Consultation" Icon="bi-clipboard2-pulse" IconBgClass="feature-icon-blue" />
    <EditForm Model="_vm" OnValidSubmit="SaveAsync" class="form-card">
        <ConsultationForm Model="_vm" />
        <FormActions SaveLabel="Update" CancelHref="@($"/client-dashboard/{_vm.PatientId}")" Saving="_saving" />
    </EditForm>
    <button class="btn btn-outline-danger mt-2" @onclick="ArchiveAsync"><i class="bi bi-archive me-1"></i> Archive</button>

    <ReferralPromptModal Visible="_showReferral" PatientId="_vm.PatientId" PatientName="@(_patientName ?? "the client")"
                         SourceModule="AppModule.Consultations" SourceRecordId="Id" OnSkipped="FinishReferralAsync" OnCompleted="FinishReferralAsync" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ConsultationFormViewModel? _vm;
    private string? _patientName;
    private bool _loading = true;
    private bool _saving;
    private bool _showReferral;

    protected override async Task OnInitializedAsync()
    {
        var e = await Api.GetConsultationAsync(Id);
        if (e is not null)
        {
            _vm = ToVm(e);
            var patient = await Api.GetPatientAsync(e.PatientId);
            _patientName = patient?.FullName;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_vm is null) return;
        _saving = true;
        var entity = Map(_vm);
        entity.Id = Id;
        try
        {
            await Api.UpdateConsultationAsync(Id, entity);
            Notifications.ShowSuccess(BuildSaveMessage());
            if (_vm.Referred)
            {
                _showReferral = true;
            }
            else
            {
                Nav.NavigateTo($"/client-dashboard/{_vm.PatientId}");
            }
        }
        finally { _saving = false; }
    }

    private string BuildSaveMessage()
    {
        if (_vm is null) return "Consultation updated.";
        var parts = new List<string> { "Consultation updated." };
        if (_vm.ItnOrder) parts.Add("ITN pharmacy task synced.");
        if (_vm.ItnDispense) parts.Add("ITN marked dispensed.");
        if (_vm.Referred) parts.Add("Select referral destinations next.");
        return string.Join(" ", parts);
    }

    private Task FinishReferralAsync()
    {
        _showReferral = false;
        if (_vm is not null)
        {
            Nav.NavigateTo($"/client-dashboard/{_vm.PatientId}");
        }
        return Task.CompletedTask;
    }

    private async Task ArchiveAsync()
    {
        var e = await Api.GetConsultationAsync(Id);
        if (e is null) return;
        await Api.DeleteConsultationAsync(Id);
        Nav.NavigateTo($"/client-dashboard/{e.PatientId}");
    }

    private static ConsultationFormViewModel ToVm(Consultation e) => new()
    {
        Id = e.Id, PatientId = e.PatientId,
        DiagnosesText = ListTextHelper.ToMultiline(e.Diagnoses),
        TreatmentsText = ListTextHelper.ToMultiline(e.Treatments),
        ServicesReferredText = ListTextHelper.ToMultiline(e.ServicesReferred),
        Referred = e.Referred == true, ItnOrder = e.ItnOrder == true, ItnDispense = e.ItnDispense == true,
        OthersDiagnosisText = ListTextHelper.ToMultiline(e.OthersDiagnosis),
        OthersTreatmentText = ListTextHelper.ToMultiline(e.OthersTreatment)
    };

    private static Consultation Map(ConsultationFormViewModel vm) => new()
    {
        PatientId = vm.PatientId,
        Diagnoses = ListTextHelper.FromMultiline(vm.DiagnosesText),
        Treatments = ListTextHelper.FromMultiline(vm.TreatmentsText),
        ServicesReferred = ListTextHelper.FromMultiline(vm.ServicesReferredText),
        Referred = vm.Referred, ItnOrder = vm.ItnOrder, ItnDispense = vm.ItnDispense,
        OthersDiagnosis = ListTextHelper.FromMultiline(vm.OthersDiagnosisText),
        OthersTreatment = ListTextHelper.FromMultiline(vm.OthersTreatmentText)
    };
}
