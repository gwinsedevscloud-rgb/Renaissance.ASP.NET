@page "/consultations"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Consultations - Renaissance</PageTitle>

<div class="module-page">
    <PageHeader Title="Consultations" Subtitle="Diagnosis, treatment, and referrals" Icon="bi-clipboard2-pulse" IconBgClass="feature-icon-blue" />

    <ReferralQueuePanel Module="AppModule.Consultations" />

    <PatientQuickSearch CreateHrefPrefix="/consultations/create" ActionLabel="New consultation" />

    @if (_loading)
    {
        <LoadingState Message="Loading consultations..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-clipboard2-pulse" Title="No consultations yet" Message="Search for a patient above to record a consultation." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>
        <div class="section-card table-card p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-consultations">
                    <ModuleRecordColGroup Widths="@(new[] { "24%", "30%", "16%", "16%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Diagnoses" Icon="bi-clipboard2-pulse" />
                            <ModuleTableTh Label="ITN" Icon="bi-bag-plus" CssClass="d-none d-md-table-cell" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(c.PatientId)" /></td>
                            <td>
                                @if (c.Diagnoses.Count == 0)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-clipboard2-pulse"></i>@string.Join(", ", c.Diagnoses.Take(3))</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (c.ItnOrder == true)
                                {
                                    <span class="record-chip is-positive"><i class="bi bi-check2"></i>Ordered</span>
                                }
                                else
                                {
                                    <span class="record-chip is-neutral"><i class="bi bi-dash"></i>None</span>
                                }
                            </td>
                            <ModuleRecordDate Value="c.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/consultations/edit/{c.Id}")" Title="Edit consultation" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Consultation> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetConsultationsAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
