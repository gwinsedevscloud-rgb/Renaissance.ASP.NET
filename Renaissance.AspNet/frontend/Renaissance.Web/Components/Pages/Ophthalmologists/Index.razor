@page "/ophthalmologists"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Ophthalmologists - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Ophthalmologists" Subtitle="Diagnosis, treatment, and surgery" Icon="bi-eye-fill" />

    <ReferralQueuePanel Module="AppModule.Ophthalmologists" />

    <PatientQuickSearch CreateHrefPrefix="/ophthalmologists/create" ActionLabel="New exam" />

    @if (_loading)
    {
        <LoadingState Message="Loading ophthalmology records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-eye-fill" Title="No ophthalmology records yet" Message="Search for a patient above to start an exam." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>

        <div class="module-mobile-list d-md-none">
            @foreach (var o in _items)
            {
                <ModuleMobileCard Patient="Patient(o.PatientId)"
                                  Primary="@(o.Diagnoses.Count == 0 ? "No diagnosis recorded" : string.Join(", ", o.Diagnoses.Take(3)))"
                                  Date="o.CreatedDate"
                                  Href="@($"/ophthalmologists/edit/{o.Id}")"
                                  Title="Edit ophthalmology record"
                                  Icon="bi-pencil" />
            }
        </div>

        <div class="section-card table-card p-0 d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-ophthalmologists">
                    <ModuleRecordColGroup Widths="@(new[] { "28%", "46%", "18%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Diagnoses" Icon="bi-eye-fill" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(o.PatientId)" /></td>
                            <td>
                                @if (o.Diagnoses.Count == 0)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-eye-fill"></i>@string.Join(", ", o.Diagnoses.Take(3))</span>
                                }
                            </td>
                            <ModuleRecordDate Value="o.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/ophthalmologists/edit/{o.Id}")" Title="Edit ophthalmology record" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Ophthalmologist> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetOphthalmologistsAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
