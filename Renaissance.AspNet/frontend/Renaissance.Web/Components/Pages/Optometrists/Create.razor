@page "/optometrists/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Optometrist Visit - MedReach</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div> }
else
{
    <PageHeader Title="New Optometrist Visit" Icon="bi-eye" />
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card">
        <OptometristForm Model="_model" />
        <FormActions SaveLabel="Save optometry record"
                     SaveIcon="bi-eye"
                     CancelHref="@($"/patient-dashboard/{PatientId}")"
                     Saving="_saving"
                     ShowReferAfterSave="true"
                     OnReferAfterSave="SaveAndReferAsync" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferral"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the patient")"
                         SourceModule="AppModule.Optometrists"
                         SourceRecordId="_savedId"
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Optometrist _model = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferral;
    private Guid? _savedId;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _model.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess("Optometrist visit saved.");
            Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        }
        finally { _saving = false; }
    }

    private async Task SaveAndReferAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess("Optometry record saved. Select modules to refer the patient to.");
            _showReferral = true;
        }
        finally { _saving = false; }
    }

    private async Task PersistAsync()
    {
        if (_model.Id == Guid.Empty) _model.Id = Guid.NewGuid();
        await Api.CreateOptometristAsync(_model);
        _savedId = _model.Id;
    }

    private Task FinishAsync() { _showReferral = false; Nav.NavigateTo($"/patient-dashboard/{PatientId}"); return Task.CompletedTask; }
}
