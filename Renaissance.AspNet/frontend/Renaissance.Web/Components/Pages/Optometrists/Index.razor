@page "/optometrists"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Optometrists - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Optometrists" Subtitle="Visual acuity exams and glasses" Icon="bi-eye" />

    <ReferralQueuePanel Module="AppModule.Optometrists" />

    <PatientQuickSearch CreateHrefPrefix="/optometrists/create" ActionLabel="New exam" />

    @if (_loading)
    {
        <LoadingState Message="Loading optometry records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-eye" Title="No optometry records yet" Message="Search for a patient above to start an exam." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>
        <div class="section-card table-card p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-optometrists">
                    <ModuleRecordColGroup Widths="@(new[] { "22%", "20%", "16%", "16%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="VA (R/L)" Icon="bi-eye" />
                            <ModuleTableTh Label="Glasses" Icon="bi-eyeglasses" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var o in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(o.PatientId)" /></td>
                            <td><span class="record-field"><i class="bi bi-eye"></i>@o.VisualAcuityRight / @o.VisualAcuityLeft</span></td>
                            <td>
                                @if (o.GlassesDispensed == true)
                                {
                                    <span class="record-chip is-positive"><i class="bi bi-check2"></i>Yes</span>
                                }
                                else
                                {
                                    <span class="record-chip is-neutral"><i class="bi bi-x"></i>No</span>
                                }
                            </td>
                            <ModuleRecordDate Value="o.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/optometrists/edit/{o.Id}")" Title="Edit optometry record" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Optometrist> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetOptometristsAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
