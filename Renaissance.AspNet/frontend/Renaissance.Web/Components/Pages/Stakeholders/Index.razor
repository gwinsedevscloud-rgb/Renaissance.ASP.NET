@page "/stakeholders"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Stakeholders Dashboard - MedReach</PageTitle>

<PageHeader
    Title="Stakeholders Dashboard"
    Subtitle="Operational analysis and forecast across all clinical modules"
    Icon="bi-graph-up-arrow"
    IconBgClass="feature-icon-blue">
    <Actions>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RefreshAsync" disabled="@_loading">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
    </Actions>
</PageHeader>

@if (!_loading && _outreachOverview?.OutreachDashboards.Count > 0)
{
    <ul class="nav nav-tabs mb-3 stakeholders-outreach-tabs">
        <li class="nav-item">
            <button type="button" class="nav-link @(_tab == "facility" ? "active" : "")" @onclick='() => _tab = "facility"'>
                <i class="bi bi-building me-1" aria-hidden="true"></i>Facility overview
            </button>
        </li>
        @foreach (var outreach in _outreachOverview!.OutreachDashboards)
        {
            <li class="nav-item">
                <button type="button" class="nav-link @(_tab == outreach.ProgramId.ToString() ? "active" : "")"
                        @onclick="() => _tab = outreach.ProgramId.ToString()">
                    <i class="bi @OutreachTabIcon(outreach) me-1" aria-hidden="true"></i>@outreach.ProgramName
                </button>
            </li>
        }
    </ul>
}

@if (_tab != "facility" && _selectedOutreach is not null)
{
    var o = _selectedOutreach;
    var targetPct = o.TargetBatchSize is > 0
        ? Math.Min(100, (int)Math.Round(100.0 * o.TotalRegistrations / o.TargetBatchSize.Value))
        : (int?)null;
    var daysLeft = Math.Max(0, (o.EndDate.Date - DateTime.Today).Days);
    var trendMax = Math.Max(1, o.RegistrationTrend.Count == 0 ? 1 : o.RegistrationTrend.Max(x => x.Count));
    var sexTotal = Math.Max(1, o.SexDistribution.Sum(x => x.Count));
    var ageTotal = Math.Max(1, o.AgeGroupDistribution.Sum(x => x.Count));
    var topStatus = o.StatusBreakdown.OrderByDescending(x => x.Count).FirstOrDefault();
    var accent = OutreachAccentClass(o);

    <div class="stakeholders-dashboard stakeholders-outreach-dash @accent mb-4">
        <div class="so-banner">
            <div class="so-banner-icon" aria-hidden="true"><i class="bi bi-megaphone-fill"></i></div>
            <div class="so-banner-copy">
                <div class="so-banner-label">@o.ProgramType outreach</div>
                <h2 class="so-banner-title">@o.ProgramName</h2>
                <p class="so-banner-meta mb-0">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i> @o.StartDate.ToString("d MMM yyyy") – @o.EndDate.ToString("d MMM yyyy")</span>
                    <span class="so-banner-dot" aria-hidden="true"></span>
                    <span><i class="bi bi-hourglass-split" aria-hidden="true"></i> @daysLeft day@(daysLeft == 1 ? "" : "s") left</span>
                </p>
            </div>
            <div class="so-banner-stat">
                <strong>@o.TotalRegistrations</strong>
                <span>registered</span>
            </div>
        </div>

        <div class="kpi-grid so-kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-teal"><i class="bi bi-people-fill"></i></div>
                <div class="kpi-value">@o.TotalRegistrations</div>
                <div class="kpi-label">Total registrations</div>
                @if (topStatus is not null)
                {
                    <div class="kpi-sub">Top status: @topStatus.Label</div>
                }
            </div>
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-blue"><i class="bi bi-calendar-plus"></i></div>
                <div class="kpi-value">@o.RegistrationsThisMonth</div>
                <div class="kpi-label">This month</div>
                <div class="kpi-sub">New in current month</div>
            </div>
            @if (o.TargetBatchSize is not null)
            {
                <div class="kpi-card so-kpi-target">
                    <div class="kpi-icon feature-icon-amber"><i class="bi bi-bullseye"></i></div>
                    <div class="kpi-value">@o.TargetBatchSize</div>
                    <div class="kpi-label">Target batch</div>
                    <div class="kpi-sub">@o.TotalRegistrations of @o.TargetBatchSize · @targetPct%</div>
                    <div class="so-progress" aria-hidden="true">
                        <span class="so-progress-fill" style="width: @(targetPct)%"></span>
                    </div>
                </div>
            }
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-slate"><i class="bi bi-graph-up"></i></div>
                <div class="kpi-value">@(o.RegistrationTrend.Count == 0 ? "—" : o.RegistrationTrend.Sum(x => x.Count))</div>
                <div class="kpi-label">Trend window</div>
                <div class="kpi-sub">@(o.RegistrationTrend.Count) day@(o.RegistrationTrend.Count == 1 ? "" : "s") tracked</div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="section-card so-panel h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-bar-chart-line"></i></span>
                        <h2>Registration trend</h2>
                    </div>
                    @if (o.RegistrationTrend.Count == 0)
                    {
                        <p class="so-empty mb-0">No daily registration data yet for this program.</p>
                    }
                    else
                    {
                        <div class="so-trend" role="img" aria-label="Daily registration counts">
                            @foreach (var day in o.RegistrationTrend)
                            {
                                var h = (int)Math.Round(100.0 * day.Count / trendMax);
                                <div class="so-trend-col" title="@day.Date.ToString("d MMM"): @day.Count">
                                    <div class="so-trend-bar-wrap">
                                        <span class="so-trend-bar" style="--bar-h: @(Math.Max(h, day.Count > 0 ? 8 : 0))%"></span>
                                    </div>
                                    <span class="so-trend-label">@day.Date.ToString("d")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="section-card so-panel h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-pie-chart"></i></span>
                        <h2>Status mix</h2>
                    </div>
                    @if (o.StatusBreakdown.Count == 0)
                    {
                        <p class="so-empty mb-0">No status data yet.</p>
                    }
                    else
                    {
                        <ul class="so-dist">
                            @foreach (var item in o.StatusBreakdown)
                            {
                                <li>
                                    <div class="so-dist-head">
                                        <span>@item.Label</span>
                                        <strong>@item.Count <span>@item.Percent.ToString("0")%</span></strong>
                                    </div>
                                    <div class="so-dist-track">
                                        <span class="so-dist-fill" style="width: @(Math.Max(item.Percent, item.Count > 0 ? 2 : 0))%"></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="row g-3 mt-0">
            <div class="col-md-6">
                <div class="section-card so-panel h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-blue"><i class="bi bi-gender-ambiguous"></i></span>
                        <h2>Gender</h2>
                    </div>
                    @if (o.SexDistribution.Count == 0)
                    {
                        <p class="so-empty mb-0">No gender data yet.</p>
                    }
                    else
                    {
                        <ul class="so-dist">
                            @foreach (var item in o.SexDistribution)
                            {
                                var pct = item.Percent > 0 ? item.Percent : 100.0 * item.Count / sexTotal;
                                var icon = SexIcon(item.Label);
                                <li>
                                    <div class="so-dist-head">
                                        <span class="so-dist-label"><i class="bi @icon" aria-hidden="true"></i> @item.Label</span>
                                        <strong>@item.Count <span>@pct.ToString("0")%</span></strong>
                                    </div>
                                    <div class="so-dist-track">
                                        <span class="so-dist-fill so-dist-fill-sex" style="width: @(Math.Max(pct, item.Count > 0 ? 2 : 0))%"></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="section-card so-panel h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-amber"><i class="bi bi-people"></i></span>
                        <h2>Age groups</h2>
                    </div>
                    @if (o.AgeGroupDistribution.Count == 0)
                    {
                        <p class="so-empty mb-0">No age-group data yet.</p>
                    }
                    else
                    {
                        <ul class="so-dist">
                            @foreach (var item in o.AgeGroupDistribution)
                            {
                                var pct = item.Percent > 0 ? item.Percent : 100.0 * item.Count / ageTotal;
                                <li>
                                    <div class="so-dist-head">
                                        <span>@item.Label</span>
                                        <strong>@item.Count <span>@pct.ToString("0")%</span></strong>
                                    </div>
                                    <div class="so-dist-track">
                                        <span class="so-dist-fill so-dist-fill-age" style="width: @(Math.Max(pct, item.Count > 0 ? 2 : 0))%"></span>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_tab == "facility")
{
@if (_loading)
{
    <LoadingState Message="Loading operational analytics..." />
}
else if (_data is null)
{
    <EmptyPanel Icon="bi-exclamation-triangle" Title="Unable to load dashboard" Message="Ensure the API is running, then refresh." />
}
else
{
    <div class="stakeholders-dashboard">
        <div class="insights-banner">
            <div class="insights-banner-icon"><i class="bi bi-lightbulb-fill"></i></div>
            <div>
                <div class="insights-banner-label">Executive summary</div>
                <p class="mb-0">@_data.Insights.Summary</p>
                <small class="text-muted">Generated @_data.GeneratedAt.ToLocalTime().ToString("f")</small>
            </div>
        </div>

        <div class="kpi-grid">
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-teal"><i class="bi bi-people-fill"></i></div>
                <div class="kpi-value">@_data.Kpis.TotalClients</div>
                <div class="kpi-label">Total patients</div>
                <div class="kpi-sub">+@_data.Kpis.NewClientsThisMonth this month</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-blue"><i class="bi bi-clipboard2-data"></i></div>
                <div class="kpi-value">@_data.Kpis.TotalEncounters</div>
                <div class="kpi-label">Total encounters</div>
                <div class="kpi-sub">@_data.Kpis.EncountersThisMonth this month</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-violet"><i class="bi bi-graph-up"></i></div>
                <div class="kpi-value @GrowthClass(_data.Kpis.MonthOverMonthGrowthPercent)">@FormatGrowth(_data.Kpis.MonthOverMonthGrowthPercent)</div>
                <div class="kpi-label">MoM encounter growth</div>
                <div class="kpi-sub">vs previous month</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-teal"><i class="bi bi-capsule"></i></div>
                <div class="kpi-value">@_data.Kpis.PharmacyDispenseRate%</div>
                <div class="kpi-label">Pharmacy dispense rate</div>
                <div class="kpi-sub">@_data.Kpis.PendingPharmacyOrders pending</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-icon feature-icon-blue"><i class="bi bi-bar-chart-line"></i></div>
                <div class="kpi-value">@_data.Kpis.AvgEncountersPerClient</div>
                <div class="kpi-label">Avg encounters / patient</div>
                <div class="kpi-sub">@_data.Kpis.ActiveModulesUsed modules active</div>
            </div>
            <div class="kpi-card kpi-card-forecast">
                <div class="kpi-icon feature-icon-violet"><i class="bi bi-binoculars-fill"></i></div>
                <div class="kpi-value">~@_data.Insights.ProjectedMonthlyEncounters.ToString("0")</div>
                <div class="kpi-label">Projected monthly encounters</div>
                <div class="kpi-sub">~@_data.Insights.ProjectedMonthlyClients.ToString("0") new patients</div>
            </div>
        </div>

        <div class="surveillance-section">
            <div class="section-card-header mb-3">
                <span class="section-icon feature-icon-coral"><i class="bi bi-shield-exclamation"></i></span>
                <div>
                    <strong>Priority disease surveillance</strong>
                    <div class="chart-subtitle">Malaria, HIV, and TB laboratory findings stakeholders monitor closely</div>
                </div>
            </div>

            <div class="surveillance-kpi-grid mb-4">
                <div class="surveillance-kpi surveillance-kpi-malaria">
                    <div class="surveillance-kpi-label">Malaria positives</div>
                    <div class="surveillance-kpi-value">@_data.LabSurveillance.MalariaPositives</div>
                </div>
                <div class="surveillance-kpi surveillance-kpi-hiv">
                    <div class="surveillance-kpi-label">HIV positives</div>
                    <div class="surveillance-kpi-value">@_data.LabSurveillance.HivPositives</div>
                </div>
                <div class="surveillance-kpi surveillance-kpi-tb">
                    <div class="surveillance-kpi-label">TB positives</div>
                    <div class="surveillance-kpi-value">@_data.LabSurveillance.TbPositives</div>
                </div>
                <div class="surveillance-kpi surveillance-kpi-rate">
                    <div class="surveillance-kpi-label">Priority positivity rate</div>
                    <div class="surveillance-kpi-value">@_data.LabSurveillance.PriorityPositivityRate%</div>
                    <div class="surveillance-kpi-sub">@_data.LabSurveillance.TotalLabTests total lab tests</div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-7">
                    <div class="section-card chart-card h-100">
                        <div class="section-card-header">
                            <span class="section-icon feature-icon-coral"><i class="bi bi-exclamation-triangle-fill"></i></span>
                            <strong>Recent priority positive results</strong>
                        </div>
                        @if (_data.LabSurveillance.RecentAlerts.Count == 0)
                        {
                            <p class="text-muted mb-0 px-3 pb-3">No malaria, HIV, or TB positive results recorded yet.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover surveillance-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>Patient</th>
                                            <th>Category</th>
                                            <th>Test</th>
                                            <th>Result</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var alert in _data.LabSurveillance.RecentAlerts)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@alert.PatientName</strong>
                                                    <span class="d-block text-muted small">@alert.ClientNumber</span>
                                                </td>
                                                <td><span class="surveillance-badge surveillance-badge-@alert.Category.ToLowerInvariant()">@alert.Category</span></td>
                                                <td>@alert.TestName</td>
                                                <td><span class="surveillance-result-positive">@alert.Result</span></td>
                                                <td><small class="text-muted">@(alert.RecordedAt?.ToLocalTime().ToString("g") ?? "—")</small></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="section-card chart-card h-100">
                        <div class="section-card-header">
                            <span class="section-icon feature-icon-violet"><i class="bi bi-heart-pulse-fill"></i></span>
                            <div>
                                <strong>Antenatal lab surveillance</strong>
                                <div class="chart-subtitle">@_data.PregnancySurveillance.PregnantWomenTracked pregnant patients · @_data.PregnancySurveillance.WithLabResults with lab results</div>
                            </div>
                        </div>
                        @if (_data.PregnancySurveillance.Cases.Count == 0)
                        {
                            <p class="text-muted mb-0 px-3 pb-3">No antenatal pregnancy records with lab follow-up yet.</p>
                        }
                        else
                        {
                            <div class="pregnancy-case-list">
                                @foreach (var pregnancyCase in _data.PregnancySurveillance.Cases)
                                {
                                    <article class="pregnancy-case-card">
                                        <div class="pregnancy-case-head">
                                            <strong>@pregnancyCase.PatientName</strong>
                                            <span class="text-muted small">@pregnancyCase.ClientNumber</span>
                                        </div>
                                        <div class="pregnancy-case-status">@pregnancyCase.PregnancyStatus</div>
                                        @if (pregnancyCase.LabResults.Count == 0)
                                        {
                                            <div class="text-muted small">No laboratory results linked yet.</div>
                                        }
                                        else
                                        {
                                            <ul class="pregnancy-lab-list">
                                                @foreach (var lab in pregnancyCase.LabResults)
                                                {
                                                    <li>
                                                        <span>@lab.TestName</span>
                                                        <strong class="@SurveillanceResultClass(lab.TestName, lab.Result)">@lab.Result</strong>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </article>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="section-card chart-card">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-activity"></i></span>
                        <div>
                            <strong>Encounter volume &amp; forecast</strong>
                            <div class="chart-subtitle">30-day trend with 14-day linear projection</div>
                        </div>
                    </div>
                    <div class="chart-container chart-container-lg">
                        <canvas id="chart-activity"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="section-card chart-card h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-violet"><i class="bi bi-pie-chart-fill"></i></span>
                        <div>
                            <strong>Module share</strong>
                            <div class="chart-subtitle">Distribution of all records</div>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="chart-module-share"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="section-card chart-card">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-blue"><i class="bi bi-bar-chart-fill"></i></span>
                        <div>
                            <strong>Records by module</strong>
                            <div class="chart-subtitle">Total volume across departments</div>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="chart-modules"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="section-card chart-card h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-person-plus-fill"></i></span>
                        <div>
                            <strong>Patient registrations &amp; forecast</strong>
                            <div class="chart-subtitle">New patient acquisition trend</div>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas id="chart-clients"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="section-card chart-card h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-blue"><i class="bi bi-gender-ambiguous"></i></span>
                        <strong>Patient sex distribution</strong>
                    </div>
                    <ul class="distribution-list">
                        @foreach (var item in _data.SexDistribution)
                        {
                            <li>
                                <span>@item.Label</span>
                                <div class="distribution-bar-wrap">
                                    <div class="distribution-bar" style="width: @(item.Percent)%"></div>
                                </div>
                                <span class="distribution-count">@item.Count (@item.Percent%)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="section-card chart-card h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-violet"><i class="bi bi-people"></i></span>
                        <strong>Age groups</strong>
                    </div>
                    <div class="chart-container chart-container-sm">
                        <canvas id="chart-demographics"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="section-card chart-card h-100">
                    <div class="section-card-header">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-capsule"></i></span>
                        <strong>Pharmacy status</strong>
                    </div>
                    <div class="chart-container chart-container-sm">
                        <canvas id="chart-pharmacy"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-card">
            <div class="section-card-header">
                <span class="section-icon feature-icon-blue"><i class="bi bi-table"></i></span>
                <strong>Module performance</strong>
            </div>
            <div class="table-responsive">
                <table class="table table-hover stakeholders-table mb-0">
                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Total</th>
                            <th>This month</th>
                            <th>Last month</th>
                            <th>Share</th>
                            <th>Trend</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _data.ModuleMetrics)
                        {
                            var delta = m.ThisMonth - m.LastMonth;
                            <tr>
                                <td><i class="bi @m.Icon me-2 text-muted"></i>@m.Module</td>
                                <td><strong>@m.Total</strong></td>
                                <td>@m.ThisMonth</td>
                                <td>@m.LastMonth</td>
                                <td>@m.SharePercent%</td>
                                <td>
                                    <span class="trend-badge @TrendClass(delta)">
                                        @if (delta > 0) { <i class="bi bi-arrow-up-short"></i> }
                                        else if (delta < 0) { <i class="bi bi-arrow-down-short"></i> }
                                        @FormatDelta(delta)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="insights-grid mt-4">
            <div class="insight-card">
                <i class="bi bi-trophy"></i>
                <div>
                    <div class="insight-label">Busiest module</div>
                    <div class="insight-value">@_data.Insights.BusiestModule</div>
                </div>
            </div>
            <div class="insight-card">
                <i class="bi bi-rocket-takeoff"></i>
                <div>
                    <div class="insight-label">Fastest growing</div>
                    <div class="insight-value">@_data.Insights.FastestGrowingModule</div>
                </div>
            </div>
            <div class="insight-card">
                <i class="bi bi-speedometer2"></i>
                <div>
                    <div class="insight-label">Avg daily encounters</div>
                    <div class="insight-value">@_data.Insights.AvgDailyEncounters</div>
                </div>
            </div>
        </div>
    </div>
}
}

@code {
    private StakeholdersDashboardViewModel? _data;
    private StakeholdersOutreachOverviewDto? _outreachOverview;
    private string _tab = "facility";
    private bool _loading = true;
    private bool _chartsRendered;

    private OutreachStakeholdersDashboardDto? _selectedOutreach =>
        _outreachOverview?.OutreachDashboards.FirstOrDefault(o => o.ProgramId.ToString() == _tab);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && _data is not null && !_chartsRendered)
        {
            _chartsRendered = true;
            await JS.InvokeVoidAsync("renaissanceCharts.renderAll", BuildChartPayload(_data));
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _chartsRendered = false;
        _data = await Api.GetStakeholdersDashboardAsync();
        _outreachOverview = await Api.GetStakeholdersOutreachOverviewAsync();
        _loading = false;
    }

    private async Task RefreshAsync()
    {
        await JS.InvokeVoidAsync("renaissanceCharts.destroyAll");
        await LoadAsync();
        if (_data is not null)
        {
            _chartsRendered = true;
            await JS.InvokeVoidAsync("renaissanceCharts.renderAll", BuildChartPayload(_data));
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("renaissanceCharts.destroyAll"); } catch { /* circuit may be gone */ }
    }

    private static object BuildChartPayload(StakeholdersDashboardViewModel d)
    {
        var activityLabels = d.ActivityTrend.Select(x => x.Date.ToString("MMM d")).ToList();
        activityLabels.AddRange(d.ActivityForecast.Select(x => x.Date.ToString("MMM d")));

        var activityActual = d.ActivityTrend.Select(x => (double?)x.Count).ToList();
        activityActual.AddRange(Enumerable.Repeat((double?)null, d.ActivityForecast.Count));

        var activityForecast = Enumerable.Repeat((double?)null, d.ActivityTrend.Count - 1).ToList();
        if (d.ActivityTrend.Count > 0)
        {
            activityForecast.Add(d.ActivityTrend[^1].Count);
        }
        activityForecast.AddRange(d.ActivityForecast.Select(x => (double?)x.Projected));

        var clientLabels = d.ClientRegistrationTrend.Select(x => x.Date.ToString("MMM d")).ToList();
        clientLabels.AddRange(d.ClientForecast.Select(x => x.Date.ToString("MMM d")));

        var clientActual = d.ClientRegistrationTrend.Select(x => (double?)x.Count).ToList();
        clientActual.AddRange(Enumerable.Repeat((double?)null, d.ClientForecast.Count));

        var clientForecast = Enumerable.Repeat((double?)null, d.ClientRegistrationTrend.Count - 1).ToList();
        if (d.ClientRegistrationTrend.Count > 0)
        {
            clientForecast.Add(d.ClientRegistrationTrend[^1].Count);
        }
        clientForecast.AddRange(d.ClientForecast.Select(x => (double?)x.Projected));

        return new
        {
            activityCombined = new { labels = activityLabels, actual = activityActual, forecast = activityForecast },
            modules = new { labels = d.ModuleMetrics.Select(m => m.Module), totals = d.ModuleMetrics.Select(m => m.Total) },
            moduleShare = new { labels = d.ModuleMetrics.Where(m => m.Total > 0).Select(m => m.Module), values = d.ModuleMetrics.Where(m => m.Total > 0).Select(m => m.Total) },
            clients = new { labels = clientLabels, actual = clientActual, forecast = clientForecast },
            demographics = new { labels = d.AgeGroupDistribution.Select(a => a.Label), values = d.AgeGroupDistribution.Select(a => a.Count) },
            pharmacy = new { labels = d.PharmacyStatusBreakdown.Select(p => p.Label), values = d.PharmacyStatusBreakdown.Select(p => p.Count) },
            surveillance = new { labels = d.LabSurveillance.PriorityTestBreakdown.Select(x => x.Label), values = d.LabSurveillance.PriorityTestBreakdown.Select(x => x.Count) }
        };
    }

    private static string SurveillanceResultClass(string testName, string result)
    {
        var positive = result.Contains("positive", StringComparison.OrdinalIgnoreCase)
            || result.Contains("reactive", StringComparison.OrdinalIgnoreCase)
            || result.Contains("detected", StringComparison.OrdinalIgnoreCase);
        if (!positive)
        {
            return "pregnancy-lab-neutral";
        }

        if (testName.Contains("malaria", StringComparison.OrdinalIgnoreCase))
        {
            return "pregnancy-lab-malaria";
        }

        if (testName.Contains("hiv", StringComparison.OrdinalIgnoreCase))
        {
            return "pregnancy-lab-hiv";
        }

        if (testName.Contains("tb", StringComparison.OrdinalIgnoreCase) || testName.Contains("afb", StringComparison.OrdinalIgnoreCase))
        {
            return "pregnancy-lab-tb";
        }

        return "pregnancy-lab-alert";
    }

    private static string FormatGrowth(double value) => value >= 0 ? $"+{value}%" : $"{value}%";
    private static string GrowthClass(double value) => value >= 0 ? "text-success" : "text-danger";
    private static string TrendClass(int delta) => delta > 0 ? "trend-up" : delta < 0 ? "trend-down" : "trend-flat";
    private static string FormatDelta(int delta) => delta == 0 ? "—" : delta > 0 ? $"+{delta}" : delta.ToString();

    private static string OutreachTabIcon(OutreachStakeholdersDashboardDto program)
    {
        if (program.ProgramName.Contains("Dental", StringComparison.OrdinalIgnoreCase))
        {
            return "bi-emoji-smile";
        }

        if (program.ProgramName.Contains("Eye", StringComparison.OrdinalIgnoreCase)
            || program.ProgramName.Contains("Optom", StringComparison.OrdinalIgnoreCase))
        {
            return "bi-eye";
        }

        if (program.ProgramName.Contains("ITN", StringComparison.OrdinalIgnoreCase)
            || program.ProgramName.Contains("Insecticide", StringComparison.OrdinalIgnoreCase))
        {
            return "bi-shield-check";
        }

        return "bi-droplet";
    }

    private static string OutreachAccentClass(OutreachStakeholdersDashboardDto program)
    {
        if (program.ProgramName.Contains("Dental", StringComparison.OrdinalIgnoreCase))
        {
            return "so-accent-dental";
        }

        if (program.ProgramName.Contains("Eye", StringComparison.OrdinalIgnoreCase)
            || program.ProgramName.Contains("Optom", StringComparison.OrdinalIgnoreCase))
        {
            return "so-accent-eye";
        }

        if (program.ProgramName.Contains("ITN", StringComparison.OrdinalIgnoreCase)
            || program.ProgramName.Contains("Insecticide", StringComparison.OrdinalIgnoreCase))
        {
            return "so-accent-itn";
        }

        return "so-accent-deworm";
    }

    private static string SexIcon(string label)
    {
        if (label.Contains("female", StringComparison.OrdinalIgnoreCase)
            || label.Equals("F", StringComparison.OrdinalIgnoreCase))
        {
            return "bi-gender-female";
        }

        if (label.Contains("male", StringComparison.OrdinalIgnoreCase)
            || label.Equals("M", StringComparison.OrdinalIgnoreCase))
        {
            return "bi-gender-male";
        }

        return "bi-person";
    }
