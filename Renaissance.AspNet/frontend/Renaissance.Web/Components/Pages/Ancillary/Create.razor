@page "/ancillary/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Ancillary Service - MedReach</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div> }
else
{
    <PageHeader Title="New Ancillary Service" Icon="bi-bandaid" />
    <EditForm Model="_vm" OnValidSubmit="SaveAsync" class="form-card">
        <AncillaryForm Model="_vm" />
        <FormActions SaveLabel="Save ancillary record"
                     SaveIcon="bi-bandaid"
                     CancelHref="@($"/patient-dashboard/{PatientId}")"
                     Saving="_saving"
                     ShowReferAfterSave="true"
                     OnReferAfterSave="SaveAndReferAsync" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferral"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the patient")"
                         SourceModule="AppModule.Ancillary"
                         SourceRecordId="_savedId"
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private AncillaryFormViewModel _vm = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferral;
    private Guid? _savedId;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _vm.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess("Ancillary service saved.");
            Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        }
        finally { _saving = false; }
    }

    private async Task SaveAndReferAsync()
    {
        _saving = true;
        try
        {
            await PersistAsync();
            Notifications.ShowSuccess("Ancillary record saved. Select modules to refer the patient to.");
            _showReferral = true;
        }
        finally { _saving = false; }
    }

    private async Task PersistAsync()
    {
        var entity = new Ancillary
        {
            Id = Guid.NewGuid(),
            PatientId = _vm.PatientId,
            Services = ListTextHelper.FromMultiline(_vm.ServicesText),
            PregnancyStatus = _vm.PregnancyStatus
        };
        await Api.CreateAncillaryAsync(entity);
        _savedId = entity.Id;
    }

    private Task FinishAsync() { _showReferral = false; Nav.NavigateTo($"/patient-dashboard/{PatientId}"); return Task.CompletedTask; }
}
