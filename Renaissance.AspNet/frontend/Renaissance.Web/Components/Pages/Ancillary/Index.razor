@page "/ancillary"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Ancillary - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Ancillary services" Subtitle="Family planning and other support services" Icon="bi-bandaid" />

    <ReferralQueuePanel Module="AppModule.Ancillary" />

    <PatientQuickSearch CreateHrefPrefix="/ancillary/create" ActionLabel="New ancillary visit" />

    @if (_loading)
    {
        <LoadingState Message="Loading ancillary records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-bandaid" Title="No ancillary records yet" Message="Search for a patient above to record a visit." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>

        <div class="module-mobile-list d-md-none">
            @foreach (var a in _items)
            {
                <ModuleMobileCard Patient="Patient(a.PatientId)"
                                  Primary="@(a.Services.Count == 0 ? "No services recorded" : string.Join(", ", a.Services.Take(3)))"
                                  Date="a.CreatedDate"
                                  Href="@($"/ancillary/edit/{a.Id}")"
                                  Title="Edit ancillary record"
                                  Icon="bi-pencil" />
            }
        </div>

        <div class="section-card table-card p-0 d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-ancillary">
                    <ModuleRecordColGroup Widths="@(new[] { "28%", "46%", "18%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Services" Icon="bi-bandaid" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(a.PatientId)" /></td>
                            <td>
                                @if (a.Services.Count == 0)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-bandaid"></i>@string.Join(", ", a.Services.Take(3))</span>
                                }
                            </td>
                            <ModuleRecordDate Value="a.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/ancillary/edit/{a.Id}")" Title="Edit ancillary record" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Ancillary> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetAncillariesAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
