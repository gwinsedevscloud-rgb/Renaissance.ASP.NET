@page "/admin/settings"

@rendermode InteractiveServer

@inject RenaissanceApiClient Api

<PageTitle>Settings - Renaissance</PageTitle>

<div class="module-page admin-settings-page">
    <PageHeader Title="Hospital settings"
                Subtitle="Facility branding and clinical service configuration"
                Icon="bi-gear-fill"
                IconBgClass="feature-icon-charcoal"
                BackHref="/admin/users"
                BackLabel="Admin">
        <Actions>
            <a class="btn btn-outline-secondary" href="/admin/lan-access">
                <i class="bi bi-wifi me-1"></i> LAN access
            </a>
            <a class="btn btn-outline-secondary" href="/admin/backup">
                <i class="bi bi-cloud-arrow-down me-1"></i> Backup
            </a>
            <a class="btn btn-outline-secondary" href="/admin/export">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export
            </a>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-success alert-dismissible fade show admin-settings-alert" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@_message
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _message = null"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger alert-dismissible fade show admin-settings-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_error
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_loading)
    {
        <LoadingState Message="Loading settings..." />
    }
    else
    {
        <div class="admin-settings-summary admin-settings-summary-compact">
            <div class="admin-settings-kpi">
                <span class="admin-settings-kpi-icon feature-icon-teal"><i class="bi bi-hospital"></i></span>
                <div>
                    <span class="admin-settings-kpi-label">Facility</span>
                    <strong>@(_form.FacilityName)</strong>
                </div>
            </div>
            <div class="admin-settings-kpi">
                <span class="admin-settings-kpi-icon feature-icon-blue"><i class="bi bi-hash"></i></span>
                <div>
                    <span class="admin-settings-kpi-label">Patient prefix</span>
                    <strong>@(_form.ClientNumberPrefix)</strong>
                </div>
            </div>
            <div class="admin-settings-kpi">
                <span class="admin-settings-kpi-icon feature-icon-violet"><i class="bi bi-clock"></i></span>
                <div>
                    <span class="admin-settings-kpi-label">Time zone</span>
                    <strong>@(_form.TimeZoneId)</strong>
                </div>
            </div>
        </div>

        <EditForm Model="_form" OnValidSubmit="SaveAsync" class="admin-settings-form">
            <DataAnnotationsValidator />

            <div class="form-card admin-settings-card">
                <FormSection Title="Facility"
                             Subtitle="Branding and patient numbering for this hospital"
                             Icon="bi-hospital"
                             IconBgClass="feature-icon-teal">
                    <div class="row g-3">
                        <div class="col-12">
                            <FormLabel Text="Hospital / facility name" Icon="bi-building" />
                            <InputText id="facilityName" class="form-control" @bind-Value="_form.FacilityName" />
                            <div class="form-text">Shown on the login screen and in the app header.</div>
                        </div>
                        <div class="col-md-6">
                            <FormLabel Text="Patient number prefix" Icon="bi-hash" />
                            <InputText id="clientPrefix" class="form-control" maxlength="10" @bind-Value="_form.ClientNumberPrefix" />
                            <div class="form-text">e.g. ACH0001</div>
                        </div>
                        <div class="col-md-6">
                            <FormLabel Text="Time zone" Icon="bi-clock" />
                            <InputText id="timeZone" class="form-control" @bind-Value="_form.TimeZoneId" />
                            <div class="form-text">Windows time zone ID</div>
                        </div>
                    </div>
                </FormSection>
            </div>

            <div class="admin-settings-save-bar">
                <p class="text-muted small mb-0">Network deployment and staff URLs are managed on the password-protected LAN access page.</p>
                <button class="btn btn-primary" type="submit" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    <i class="bi bi-check2-circle me-1"></i>
                    Save facility settings
                </button>
            </div>
        </EditForm>

        <ModuleServicesSettings OnMessage="msg => _message = msg" OnError="err => _error = err" />
    }
</div>

@code {
    private UpdateHospitalSettingsRequest _form = new();
    private bool _loading = true;
    private bool _saving;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var settings = await Api.GetHospitalSettingsAsync();
            _form = new UpdateHospitalSettingsRequest
            {
                FacilityName = settings.FacilityName,
                ClientNumberPrefix = settings.ClientNumberPrefix,
                TimeZoneId = settings.TimeZoneId
            };
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;
        _message = null;
        try
        {
            await Api.UpdateHospitalSettingsAsync(_form);
            _message = "Facility settings saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
