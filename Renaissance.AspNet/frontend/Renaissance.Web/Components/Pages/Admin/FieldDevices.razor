@page "/admin/field-devices"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Field devices - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Field devices"
                Subtitle="Tablets that pull catalogs or push offline outreach records to the hospital"
                Icon="bi-tablet"
                BackHref="/admin/settings"
                BackLabel="Settings">
        <Actions>
            <a class="btn btn-outline-secondary" href="/admin/care-programs">
                <i class="bi bi-megaphone me-1"></i> Care programs
            </a>
            <button class="btn btn-primary" type="button" disabled="@_loading" @onclick="ReloadAsync">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-arrow-repeat me-1"></i>
                }
                Refresh
            </button>
        </Actions>
    </PageHeader>

    <div class="alert alert-light border d-flex align-items-start gap-2 mb-3">
        <i class="bi bi-info-circle text-primary mt-1"></i>
        <div class="small mb-0">
            Devices register automatically when the <strong>MedReach Field</strong> PWA syncs while online.
            Set a friendly label on each tablet under <em>Device</em> so staff can recognize them here.
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-octagon me-1"></i>@_error
            <button type="button" class="btn-close" aria-label="Dismiss" @onclick="() => _error = null"></button>
        </div>
    }

    @if (_loading && _devices.Count == 0)
    {
        <LoadingState Message="Loading field devices..." />
    }
    else if (_devices.Count == 0)
    {
        <EmptyPanel Icon="bi-tablet"
                    Title="No field devices yet"
                    Message="Open MedReach Field on a tablet, sign in, and refresh settings or sync once while online." />
    }
    else
    {
        <div class="row g-3 mb-3">
            <div class="col-sm-4">
                <div class="section-card field-device-stat h-100">
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-tablet"></i></span>
                        <div>
                            <div class="text-muted small text-uppercase fw-semibold">Devices</div>
                            <div class="fs-4 fw-bold lh-1">@_devices.Count</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="section-card field-device-stat h-100">
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-wifi"></i></span>
                        <div>
                            <div class="text-muted small text-uppercase fw-semibold">Seen recently</div>
                            <div class="fs-4 fw-bold lh-1">@_recentCount</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="section-card field-device-stat h-100">
                    <div class="d-flex align-items-center gap-3">
                        <span class="section-icon feature-icon-teal"><i class="bi bi-cloud-check"></i></span>
                        <div>
                            <div class="text-muted small text-uppercase fw-semibold">Sync receipts</div>
                            <div class="fs-4 fw-bold lh-1">@_receiptTotal</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="record-meta">
            <strong>@_devices.Count</strong> tablet@(_devices.Count == 1 ? "" : "s")
            · Sorted by last activity
        </div>

        <div class="section-card table-card p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <ModuleRecordColGroup Widths="@(new[] { "22%", "18%", "14%", "14%", "14%", "8%", "10%" })" />
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th class="d-none d-md-table-cell">Device ID</th>
                            <th>Last seen</th>
                            <th class="d-none d-lg-table-cell">Last pull</th>
                            <th class="d-none d-lg-table-cell">Last push</th>
                            <th>Receipts</th>
                            <th>Last user</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _devices)
                        {
                            var label = string.IsNullOrWhiteSpace(d.DeviceLabel) ? "Unnamed tablet" : d.DeviceLabel!;
                            var recent = IsRecent(d.LastSeenUtc);
                            <tr>
                                <td>
                                    <div class="client-cell">
                                        <span class="client-avatar field-device-avatar">
                                            <i class="bi bi-tablet"></i>
                                        </span>
                                        <div>
                                            <strong>@label</strong>
                                            <div class="small">
                                                @if (recent)
                                                {
                                                    <span class="badge text-bg-success"><i class="bi bi-circle-fill me-1" style="font-size:0.45rem;vertical-align:middle;"></i>Recent</span>
                                                }
                                                else if (d.LastSeenUtc is null)
                                                {
                                                    <span class="badge text-bg-secondary">Never synced</span>
                                                }
                                                else
                                                {
                                                    <span class="badge text-bg-light text-muted border">Idle</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell">
                                    <code class="small" title="@d.DeviceId">@ShortId(d.DeviceId)</code>
                                </td>
                                <td>
                                    <span title="@(d.LastSeenUtc?.ToString("u") ?? "")">@FormatWhen(d.LastSeenUtc)</span>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <span title="@(d.LastPullUtc?.ToString("u") ?? "")">@FormatWhen(d.LastPullUtc)</span>
                                </td>
                                <td class="d-none d-lg-table-cell">
                                    <span title="@(d.LastPushUtc?.ToString("u") ?? "")">@FormatWhen(d.LastPushUtc)</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill text-bg-light border">@d.ReceiptCount</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(d.LastActor))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-person me-1 text-muted"></i>@d.LastActor</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<FieldDeviceDto> _devices = [];
    private bool _loading = true;
    private string? _error;

    private int _recentCount => _devices.Count(d => IsRecent(d.LastSeenUtc));
    private int _receiptTotal => _devices.Sum(d => d.ReceiptCount);

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || !Auth.HasModule(AppModule.Administration))
        {
            Nav.NavigateTo("/");
            return;
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var list = await Api.GetFieldDevicesAsync() ?? [];
            _devices = list
                .OrderByDescending(d => d.LastSeenUtc ?? DateTime.MinValue)
                .ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsRecent(DateTime? utc)
        => utc.HasValue && utc.Value >= DateTime.UtcNow.AddHours(-24);

    private static string ShortId(string id)
    {
        if (string.IsNullOrWhiteSpace(id)) return "—";
        return id.Length <= 12 ? id : $"{id[..8]}…{id[^4..]}";
    }

    private static string FormatWhen(DateTime? utc)
    {
        if (utc is null) return "—";
        var local = DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc).ToLocalTime();
        var age = DateTime.Now - local;
        if (age.TotalMinutes < 1) return "Just now";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m ago";
        if (age.TotalHours < 24) return $"{(int)age.TotalHours}h ago";
        if (age.TotalDays < 7) return $"{(int)age.TotalDays}d ago";
        return local.ToString("g");
    }
}
