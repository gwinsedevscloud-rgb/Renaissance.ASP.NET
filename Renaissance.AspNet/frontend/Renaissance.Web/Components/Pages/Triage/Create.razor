@page "/triage/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Triage - Renaissance</PageTitle>

@if (!_exists) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Client not found.</div> }
else
{
    <PageHeader Title="New Triage" Subtitle="Record vitals and medical history" Icon="bi-activity" />
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card">
        <TriageForm Model="_model" />
        <FormActions SaveLabel="Save Triage" SaveIcon="bi-activity" CancelHref="@($"/client-dashboard/{PatientId}")" Saving="_saving" />
    </EditForm>

    <ReferralPromptModal Visible="_showReferralPrompt"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the client")"
                         SourceModule="AppModule.Triage"
                         SourceRecordId="_savedTriageId"
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Triage _model = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showReferralPrompt;
    private Guid? _savedTriageId;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _model.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        if (_model.Id == Guid.Empty) _model.Id = Guid.NewGuid();
        try
        {
            var created = await Api.CreateTriageAsync(_model);
            _savedTriageId = created.Id;
            Notifications.ShowSuccess("Triage saved.");
            _showReferralPrompt = true;
        }
        finally
        {
            _saving = false;
        }
    }

    private Task FinishAsync()
    {
        _showReferralPrompt = false;
        Nav.NavigateTo($"/client-dashboard/{PatientId}");
        return Task.CompletedTask;
    }
}
