@page "/triage/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications
@inject OutreachStateService Outreach

<PageTitle>New Triage - MedReach</PageTitle>

@if (!_exists)
{
    <div class="module-page module-triage">
        <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div>
    </div>
}
else
{
    <div class="module-page module-triage">
        <header class="triage-station-header triage-station-header-compact">
            <a class="triage-back-link" href="@($"/patient-dashboard/{PatientId}")">
                <i class="bi bi-arrow-left"></i> Patient dashboard
            </a>
            <div class="triage-station-brand">
                <span class="triage-station-icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
                <div>
                    <h1>New triage</h1>
                    <p>Record vitals for this encounter</p>
                </div>
            </div>
        </header>

        @if (_patient is not null)
        {
            <div class="triage-patient-strip">
                <ClientIdentity Patient="_patient" />
                <span class="triage-patient-tag"><i class="bi bi-plus-circle"></i> New encounter</span>
            </div>
        }

        <div class="pharmacy-catalog-hint mb-3">
            <i class="bi bi-arrow-right-circle"></i>
            @if (Outreach.IsOutreachMode && ClinicReferralTargets.Count > 0)
            {
                <span>
                    After saving, the patient continues on the primary outreach path
                    (<strong>Laboratory → Consultation → Pharmacy</strong>)
                    and you can refer them to <strong>Dental Clinic</strong> and/or <strong>Eye Clinic</strong>.
                </span>
            }
            else if (Outreach.IsOutreachMode)
            {
                <span>After saving, this patient is <strong>automatically referred to Laboratory</strong> (outreach flow).</span>
            }
            else
            {
                <span>After saving, this patient is <strong>automatically referred to Consultations</strong> for clinician review.</span>
            }
        </div>

        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="triage-form-shell">
            <TriageForm Model="_model" />
            <FormActions SaveLabel="Save triage" SaveIcon="bi-activity" CancelHref="@($"/patient-dashboard/{PatientId}")" Saving="_saving" />
        </EditForm>
    </div>

    <ReferralPromptModal Visible="_showClinicReferral"
                         PatientId="PatientId"
                         PatientName="@(_patient?.FullName ?? "the patient")"
                         SourceModule="AppModule.Triage"
                         SourceRecordId="_savedTriageId"
                         Title="Refer to outreach clinics"
                         Subtitle="Send this patient to Dental Clinic and/or Eye Clinic after triage."
                         SkipLabel="Continue without clinic referral"
                         AllowedTargetModules="ClinicReferralTargets"
                         TargetLabels="ClinicLabels"
                         OnSkipped="FinishAsync"
                         OnCompleted="FinishAsync" />
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Triage _model = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;
    private bool _showClinicReferral;
    private Guid? _savedTriageId;

    private List<AppModule> ClinicReferralTargets => Outreach.ActiveSecondaryPrograms
        .Where(p => p.LinkedClinicalModule is AppModule.Dental or AppModule.Optometrists)
        .Select(p => p.LinkedClinicalModule!.Value)
        .Distinct()
        .ToList();

    private Dictionary<AppModule, string> ClinicLabels =>
        Outreach.ActiveSecondaryPrograms
            .Where(p => p.LinkedClinicalModule.HasValue)
            .GroupBy(p => p.LinkedClinicalModule!.Value)
            .ToDictionary(g => g.Key, g => g.First().Name);

    protected override async Task OnInitializedAsync()
    {
        if (!Outreach.IsLoaded)
        {
            await Outreach.LoadAsync(Api);
        }

        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _model.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        if (_model.Id == Guid.Empty) _model.Id = Guid.NewGuid();
        try
        {
            var saved = await Api.CreateTriageAsync(_model);
            _savedTriageId = saved.Id;

            if (Outreach.IsOutreachMode && ClinicReferralTargets.Count > 0)
            {
                Notifications.ShowSuccess("Triage saved. Choose clinic referrals if needed.");
                _showClinicReferral = true;
            }
            else
            {
                Notifications.ShowSuccess(Outreach.IsOutreachMode
                    ? "Triage saved. Patient referred to Laboratory."
                    : "Triage saved. Patient referred to Consultations.");
                await FinishAsync();
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private Task FinishAsync()
    {
        _showClinicReferral = false;
        Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        return Task.CompletedTask;
    }
}
