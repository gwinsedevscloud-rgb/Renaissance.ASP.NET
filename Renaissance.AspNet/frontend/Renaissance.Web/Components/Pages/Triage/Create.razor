@page "/triage/create/{PatientId:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>New Triage - Renaissance</PageTitle>

@if (!_exists)
{
    <div class="module-page module-triage">
        <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Patient not found.</div>
    </div>
}
else
{
    <div class="module-page module-triage">
        <header class="triage-station-header triage-station-header-compact">
            <a class="triage-back-link" href="@($"/patient-dashboard/{PatientId}")">
                <i class="bi bi-arrow-left"></i> Patient dashboard
            </a>
            <div class="triage-station-brand">
                <span class="triage-station-icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
                <div>
                    <h1>New triage</h1>
                    <p>Record vitals and medical history</p>
                </div>
            </div>
        </header>

        @if (_patient is not null)
        {
            <div class="triage-patient-strip">
                <ClientIdentity Patient="_patient" />
                <span class="triage-patient-tag"><i class="bi bi-plus-circle"></i> New encounter</span>
            </div>
        }

        <div class="pharmacy-catalog-hint mb-3">
            <i class="bi bi-arrow-right-circle"></i>
            After saving, this patient is <strong>automatically referred to Consultations</strong> for clinician review.
        </div>

        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="triage-form-shell">
            <TriageForm Model="_model" />
            <FormActions SaveLabel="Save triage" SaveIcon="bi-activity" CancelHref="@($"/patient-dashboard/{PatientId}")" Saving="_saving" />
        </EditForm>
    </div>
}

@code {
    [Parameter] public Guid PatientId { get; set; }
    private Triage _model = new();
    private Patient? _patient;
    private bool _exists;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        _patient = await Api.GetPatientAsync(PatientId);
        _exists = _patient is not null;
        _model.PatientId = PatientId;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        if (_model.Id == Guid.Empty) _model.Id = Guid.NewGuid();
        try
        {
            await Api.CreateTriageAsync(_model);
            Notifications.ShowSuccess("Triage saved. Patient referred to Consultations.");
            Nav.NavigateTo($"/patient-dashboard/{PatientId}");
        }
        finally
        {
            _saving = false;
        }
    }
}
