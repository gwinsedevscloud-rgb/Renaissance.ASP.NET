@page "/triage/edit/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Edit Triage - Renaissance</PageTitle>

@if (_loading) { <LoadingState /> }
else if (_model is null) { <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Triage not found.</div> }
else
{
    <PageHeader Title="Edit Triage" Icon="bi-activity" />
    <EditForm Model="_model" OnValidSubmit="SaveAsync" class="form-card">
        <TriageForm Model="_model" />
        <FormActions SaveLabel="Update" CancelHref="@($"/patient-dashboard/{_model.PatientId}")" />
    </EditForm>
    <button class="btn btn-outline-danger mt-2" @onclick="ArchiveAsync"><i class="bi bi-archive me-1"></i> Archive</button>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private Triage? _model;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _model = await Api.GetTriageAsync(Id);
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        await Api.UpdateTriageAsync(Id, _model);
        Notifications.ShowSuccess("Triage updated.");
        Nav.NavigateTo($"/patient-dashboard/{_model.PatientId}");
    }

    private async Task ArchiveAsync()
    {
        if (_model is null) return;
        var pid = _model.PatientId;
        await Api.DeleteTriageAsync(Id);
        Nav.NavigateTo($"/patient-dashboard/{pid}");
    }
}
