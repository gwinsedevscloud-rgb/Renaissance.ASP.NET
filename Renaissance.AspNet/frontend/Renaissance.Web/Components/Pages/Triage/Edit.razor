@page "/triage/edit/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject NavigationManager Nav
@inject NotificationService Notifications

<PageTitle>Edit Triage - Renaissance</PageTitle>

<div class="module-page module-triage">
    @if (_loading)
    {
        <LoadingState />
    }
    else if (_model is null)
    {
        <div class="empty-state"><i class="bi bi-exclamation-circle d-block"></i> Triage not found.</div>
    }
    else
    {
        <header class="triage-station-header triage-station-header-compact">
            <a class="triage-back-link" href="@($"/patient-dashboard/{_model.PatientId}")">
                <i class="bi bi-arrow-left"></i> Patient dashboard
            </a>
            <div class="triage-station-brand">
                <span class="triage-station-icon" aria-hidden="true"><i class="bi bi-activity"></i></span>
                <div>
                    <h1>Edit triage</h1>
                    <p>Update vitals and medical history</p>
                </div>
            </div>
        </header>

        @if (_patient is not null)
        {
            <div class="triage-patient-strip">
                <ClientIdentity Patient="_patient" />
                <span class="triage-patient-tag"><i class="bi bi-pencil"></i> Editing record</span>
            </div>
        }

        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="triage-form-shell">
            <TriageForm Model="_model" />
            <FormActions SaveLabel="Update triage" SaveIcon="bi-check-lg" CancelHref="@($"/patient-dashboard/{_model.PatientId}")" />
        </EditForm>

        <div class="triage-danger-zone">
            <button class="btn btn-outline-danger" type="button" @onclick="ArchiveAsync">
                <i class="bi bi-archive me-1"></i> Archive record
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private Triage? _model;
    private Patient? _patient;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _model = await Api.GetTriageAsync(Id);
        if (_model is not null)
        {
            _patient = await Api.GetPatientAsync(_model.PatientId);
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        await Api.UpdateTriageAsync(Id, _model);
        Notifications.ShowSuccess("Triage updated.");
        Nav.NavigateTo($"/patient-dashboard/{_model.PatientId}");
    }

    private async Task ArchiveAsync()
    {
        if (_model is null) return;
        var pid = _model.PatientId;
        await Api.DeleteTriageAsync(Id);
        Nav.NavigateTo($"/patient-dashboard/{pid}");
    }
}
