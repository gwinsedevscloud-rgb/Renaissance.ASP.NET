@page "/triage"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Triage - Renaissance</PageTitle>

<div class="module-page">
    <PageHeader Title="Triage" Subtitle="Record vitals and open a new encounter" Icon="bi-activity" />

    <PatientQuickSearch CreateHrefPrefix="/triage/create" ActionLabel="New triage" />

    @if (_loading)
    {
        <LoadingState Message="Loading triage records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-activity" Title="No triage records yet" Message="Search for a patient above to start a new encounter." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>
        <div class="section-card table-card p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-triage">
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="BP" Icon="bi-heart-pulse" />
                            <ModuleTableTh Label="Temp" Icon="bi-thermometer-half" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableTh Label="Pulse" Icon="bi-activity" CssClass="d-none d-md-table-cell" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var t in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(t.PatientId)" /></td>
                            <td><span class="record-field"><i class="bi bi-heart-pulse"></i>@t.SystolicBp/@t.DiastolicBp</span></td>
                            <td class="d-none d-sm-table-cell">
                                @if (t.Temperature is null)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-thermometer-half"></i>@t.Temperature.Value.ToString("0.0")°C</span>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (t.PulseRate is null)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-activity"></i>@t.PulseRate bpm</span>
                                }
                            </td>
                            <ModuleRecordDate Value="t.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/triage/edit/{t.Id}")" Title="Edit triage" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<Triage> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetTriagesAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
