@page "/patient-dashboard/{Id:guid}"
@page "/client-dashboard/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject AuthStateService Auth

<PageTitle>Patient Dashboard - Renaissance</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading dashboard..." />
}
else if (_dashboard is null)
{
    <EmptyPanel Icon="bi-exclamation-circle" Title="Patient not found" Message="This patient may have been archived or the link is invalid.">
        <a class="btn btn-primary" href="/patients">All Patients</a>
    </EmptyPanel>
}
else
{
    var patient = _dashboard.Patient;
    var patientId = patient.Id;

    <div class="patient-dashboard">
        <header class="pd-profile">
            <div class="pd-profile-glow" aria-hidden="true"></div>
            <div class="pd-profile-inner">
                <div class="pd-profile-main">
                    <div class="pd-avatar">@ClientDisplayHelper.Initials(patient)</div>
                    <div class="pd-identity">
                        <div class="pd-name-row">
                            <h1>@ClientDisplayHelper.DisplayName(patient)</h1>
                            <span class="pd-id-badge">@patient.ClientNumber</span>
                        </div>
                        <div class="pd-meta">
                            <span class="pd-meta-pill"><i class="bi bi-gender-ambiguous"></i> @patient.Sex</span>
                            <span class="pd-meta-pill"><i class="bi bi-calendar3"></i> @patient.Age @patient.AgeUnit</span>
                            <span class="pd-meta-pill"><i class="bi bi-telephone"></i> @(patient.PhoneNumber ?? "No phone")</span>
                        </div>
                    </div>
                </div>

                <div class="pd-profile-side">
                    <div class="pd-stat-grid">
                        <div class="pd-stat">
                            <strong>@TotalRecords</strong>
                            <span>Records</span>
                        </div>
                        <div class="pd-stat">
                            <strong>@_dashboard.Triages.Count</strong>
                            <span>Triage</span>
                        </div>
                        <div class="pd-stat">
                            <strong>@_dashboard.Consultations.Count</strong>
                            <span>Consults</span>
                        </div>
                    </div>
                    <a class="pd-back-link" href="/patients">
                        <i class="bi bi-arrow-left"></i> All patients
                    </a>
                </div>
            </div>
        </header>

        <PatientJourneyPanel PatientId="patientId" />

        @if (_dashboard.HasPendingPharmacy && Auth.HasModule(AppModule.Pharmacy))
        {
            <div class="pd-alert pd-alert-pharmacy">
                <div class="pd-alert-icon"><i class="bi bi-capsule"></i></div>
                <div class="pd-alert-body">
                    <strong>Pharmacy pending</strong>
                    <span>Prescriptions need dispensation for this patient.</span>
                </div>
                <a class="pd-alert-action" href="/pharmacy/dispense/@patientId">
                    Dispense now <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        }

        <section class="pd-actions">
            <div class="pd-section-head">
                <span class="pd-section-icon"><i class="bi bi-plus-circle"></i></span>
                <div>
                    <h2>Start encounter</h2>
                    <p>Open a module to record care for this patient</p>
                </div>
            </div>
            <div class="pd-action-grid">
                @if (Auth.HasModule(AppModule.Triage)) { <ActionChip Href="@($"/triage/create/{patientId}")" Icon="bi-activity" Label="Triage" CssClass="pd-chip pd-chip-triage" /> }
                @if (Auth.HasModule(AppModule.Consultations)) { <ActionChip Href="@($"/consultations/create/{patientId}")" Icon="bi-clipboard2-pulse" Label="Consultation" CssClass="pd-chip pd-chip-consult" /> }
                @if (Auth.HasModule(AppModule.Pharmacy))
                {
                    <ActionChip Href="@($"/pharmacy/create/{patientId}")" Icon="bi-prescription2" Label="Prescribe" CssClass="pd-chip pd-chip-pharmacy" />
                    <ActionChip Href="@($"/pharmacy/dispense/{patientId}")" Icon="bi-capsule" Label="Dispense" CssClass="pd-chip pd-chip-pharmacy pd-chip-outline" />
                }
                @if (Auth.HasModule(AppModule.Laboratory)) { <ActionChip Href="@($"/laboratory/create/{patientId}")" Icon="bi-droplet-half" Label="Laboratory" CssClass="pd-chip pd-chip-lab" /> }
                @if (Auth.HasModule(AppModule.Dental)) { <ActionChip Href="@($"/dental/create/{patientId}")" Icon="bi-emoji-smile" Label="Dental" CssClass="pd-chip pd-chip-dental" /> }
                @if (Auth.HasModule(AppModule.Ancillary)) { <ActionChip Href="@($"/ancillary/create/{patientId}")" Icon="bi-bandaid" Label="Ancillary" CssClass="pd-chip pd-chip-ancillary" /> }
                @if (Auth.HasModule(AppModule.Optometrists)) { <ActionChip Href="@($"/optometrists/create/{patientId}")" Icon="bi-eye" Label="Optometrist" CssClass="pd-chip pd-chip-optometry" /> }
                @if (Auth.HasModule(AppModule.Ophthalmologists)) { <ActionChip Href="@($"/ophthalmologists/create/{patientId}")" Icon="bi-eye-fill" Label="Ophthalmologist" CssClass="pd-chip pd-chip-ophthalmology" /> }
            </div>
        </section>

        <section class="pd-records">
            <div class="pd-section-head pd-section-head-compact">
                <span class="pd-section-icon pd-section-icon-muted"><i class="bi bi-journal-medical"></i></span>
                <div>
                    <h2>Clinical history</h2>
                    <p>Recent records across all modules</p>
                </div>
            </div>

            <div class="pd-records-grid">
                <SectionList Title="Triage" Icon="bi-activity" IconBgClass="feature-icon-coral" Count="_dashboard.Triages.Count" EmptyIcon="bi-activity" CssClass="pd-record-card section-card-stretch">
                    @foreach (var t in _dashboard.Triages)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title"><i class="bi bi-heart-pulse"></i> BP @t.SystolicBp/@t.DiastolicBp · @t.Temperature°C</span>
                                <span class="pd-record-meta">@(t.CreatedDate?.ToLocalTime().ToString("MMM d, yyyy · h:mm tt") ?? "—")</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Triage))
                            {
                                <a class="pd-record-edit" href="/triage/edit/@t.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Consultations" Icon="bi-clipboard2-pulse" IconBgClass="feature-icon-blue" Count="_dashboard.Consultations.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var c in _dashboard.Consultations)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">@(string.IsNullOrWhiteSpace(string.Join(", ", c.Diagnoses)) ? "No diagnosis recorded" : string.Join(", ", c.Diagnoses.Take(3)))</span>
                                <span class="pd-record-meta">ITN: @(c.ItnOrder == true ? "ordered" : "—") / @(c.ItnDispense == true ? "dispensed" : "not dispensed")</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Consultations))
                            {
                                <a class="pd-record-edit" href="/consultations/edit/@c.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Pharmacy" Icon="bi-capsule" IconBgClass="feature-icon-indigo" Count="_dashboard.Prescriptions.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var p in _dashboard.Prescriptions)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title"><i class="bi bi-prescription"></i> @p.DrugName <StatusBadge Status="p.Status" /></span>
                                <span class="pd-record-meta">@(p.CreatedDate?.ToLocalTime().ToString("MMM d, yyyy · h:mm tt") ?? "—")</span>
                            </div>
                        </div>
                    }
                </SectionList>

                <SectionList Title="Laboratory" Icon="bi-droplet-half" IconBgClass="feature-icon-blue" Count="_dashboard.Laboratories.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var l in _dashboard.Laboratories)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">@l.TestName</span>
                                <span class="pd-record-meta">Result: <strong>@(l.Result ?? "pending")</strong></span>
                            </div>
                            @if (Auth.HasModule(AppModule.Laboratory))
                            {
                                <a class="pd-record-edit" href="/laboratory/edit/@l.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Dental" Icon="bi-emoji-smile" Count="_dashboard.DentalConsultations.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var d in _dashboard.DentalConsultations)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">@(string.Join(", ", d.Diagnoses.Take(3)))</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Dental))
                            {
                                <a class="pd-record-edit" href="/dental/edit/@d.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Ancillary" Icon="bi-bandaid" Count="_dashboard.Ancillaries.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var a in _dashboard.Ancillaries)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">@string.Join(", ", a.Services)</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Ancillary))
                            {
                                <a class="pd-record-edit" href="/ancillary/edit/@a.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Optometrist" Icon="bi-eye" Count="_dashboard.Optometrists.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var o in _dashboard.Optometrists)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">VA R: @o.VisualAcuityRight · L: @o.VisualAcuityLeft</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Optometrists))
                            {
                                <a class="pd-record-edit" href="/optometrists/edit/@o.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>

                <SectionList Title="Ophthalmologist" Icon="bi-eye-fill" Count="_dashboard.Ophthalmologists.Count" CssClass="pd-record-card section-card-stretch">
                    @foreach (var o in _dashboard.Ophthalmologists)
                    {
                        <div class="pd-record-row">
                            <div class="pd-record-body">
                                <span class="pd-record-title">@(string.Join(", ", o.Diagnoses.Take(3)))</span>
                            </div>
                            @if (Auth.HasModule(AppModule.Ophthalmologists))
                            {
                                <a class="pd-record-edit" href="/ophthalmologists/edit/@o.Id"><i class="bi bi-pencil"></i></a>
                            }
                        </div>
                    }
                </SectionList>
            </div>
        </section>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ClientDashboardViewModel? _dashboard;
    private bool _loading = true;

    private int TotalRecords =>
        _dashboard is null ? 0
        : _dashboard.Triages.Count
          + _dashboard.Consultations.Count
          + _dashboard.Prescriptions.Count
          + _dashboard.Laboratories.Count
          + _dashboard.DentalConsultations.Count
          + _dashboard.Ancillaries.Count
          + _dashboard.Optometrists.Count
          + _dashboard.Ophthalmologists.Count;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await Api.GetDashboardAsync(Id);
        _loading = false;
    }
}
