@page "/client-dashboard/{Id:guid}"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api
@inject AuthStateService Auth

<PageTitle>Client Dashboard - Renaissance</PageTitle>

@if (_loading)
{
    <LoadingState Message="Loading dashboard..." />
}
else if (_dashboard is null)
{
    <EmptyPanel Icon="bi-exclamation-circle" Title="Client not found" Message="This client may have been archived or the link is invalid.">
        <a class="btn btn-primary" href="/patients">All Clients</a>
    </EmptyPanel>
}
else
{
    var patient = _dashboard.Patient;
    var patientId = patient.Id;

    <div class="patient-hero">
        <div class="d-flex gap-3 align-items-start">
            <div class="patient-hero-avatar">@ClientDisplayHelper.Initials(patient)</div>
            <div>
                <h1 class="h3 mb-1">@ClientDisplayHelper.DisplayName(patient)</h1>
                <div class="client-number mb-1">@patient.ClientNumber</div>
                <div class="patient-meta">
                    <span class="patient-meta-item"><i class="bi bi-gender-ambiguous"></i> @patient.Sex</span>
                    <span class="patient-meta-item"><i class="bi bi-calendar3"></i> @patient.Age @patient.AgeUnit</span>
                    <span class="patient-meta-item"><i class="bi bi-telephone"></i> @(patient.PhoneNumber ?? "No phone")</span>
                </div>
            </div>
        </div>
        <a class="btn btn-outline-secondary" href="/patients">
            <i class="bi bi-arrow-left me-1"></i> All Clients
        </a>
    </div>

    <PatientJourneyPanel PatientId="patientId" />

    @if (_dashboard.HasPendingPharmacy && Auth.HasModule(AppModule.Pharmacy))
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <span class="flex-grow-1">Pending pharmacy prescriptions require dispensation.</span>
            <a class="btn btn-sm btn-warning" href="/pharmacy/dispense/@patientId">
                <i class="bi bi-capsule me-1"></i> Dispense now
            </a>
        </div>
    }

    <div class="section-card mb-4">
        <div class="section-card-header">
            <span class="section-icon feature-icon-teal"><i class="bi bi-plus-circle"></i></span>
            <h2>Quick Actions</h2>
        </div>
        <div class="action-grid">
            @if (Auth.HasModule(AppModule.Triage)) { <ActionChip Href="@($"/triage/create/{patientId}")" Icon="bi-activity" Label="Triage" /> }
            @if (Auth.HasModule(AppModule.Consultations)) { <ActionChip Href="@($"/consultations/create/{patientId}")" Icon="bi-clipboard2-pulse" Label="Consultation" /> }
            @if (Auth.HasModule(AppModule.Pharmacy))
            {
                <ActionChip Href="@($"/pharmacy/create/{patientId}")" Icon="bi-prescription2" Label="Prescribe" />
                <ActionChip Href="@($"/pharmacy/dispense/{patientId}")" Icon="bi-capsule" Label="Dispense" CssClass="chip-outline" />
            }
            @if (Auth.HasModule(AppModule.Laboratory)) { <ActionChip Href="@($"/laboratory/create/{patientId}")" Icon="bi-droplet-half" Label="Laboratory" /> }
            @if (Auth.HasModule(AppModule.Dental)) { <ActionChip Href="@($"/dental/create/{patientId}")" Icon="bi-emoji-smile" Label="Dental" /> }
            @if (Auth.HasModule(AppModule.Ancillary)) { <ActionChip Href="@($"/ancillary/create/{patientId}")" Icon="bi-bandaid" Label="Ancillary" /> }
            @if (Auth.HasModule(AppModule.Optometrists)) { <ActionChip Href="@($"/optometrists/create/{patientId}")" Icon="bi-eye" Label="Optometrist" /> }
            @if (Auth.HasModule(AppModule.Ophthalmologists)) { <ActionChip Href="@($"/ophthalmologists/create/{patientId}")" Icon="bi-eye-fill" Label="Ophthalmologist" /> }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <SectionList Title="Triage" Icon="bi-activity" IconBgClass="feature-icon-teal" Count="_dashboard.Triages.Count" EmptyIcon="bi-activity">
                @foreach (var t in _dashboard.Triages)
                {
                    <div class="record-item">
                        <span><i class="bi bi-heart-pulse me-1 text-muted"></i> BP @t.SystolicBp/@t.DiastolicBp · Temp @t.Temperature°C<br />
                            <small class="text-muted">@(t.CreatedDate?.ToLocalTime().ToString("g") ?? "—")</small></span>
                        <a href="/triage/edit/@t.Id" class="@(Auth.HasModule(AppModule.Triage) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>

            <SectionList Title="Consultations" Icon="bi-clipboard2-pulse" IconBgClass="feature-icon-blue" Count="_dashboard.Consultations.Count">
                @foreach (var c in _dashboard.Consultations)
                {
                    <div class="record-item">
                        <span>
                            @(string.IsNullOrWhiteSpace(string.Join(", ", c.Diagnoses)) ? "No diagnosis recorded" : string.Join(", ", c.Diagnoses.Take(3)))
                            <br /><small class="text-muted"><i class="bi bi-moon-stars me-1"></i>ITN: @(c.ItnOrder == true ? "ordered" : "—") / @(c.ItnDispense == true ? "dispensed" : "not dispensed")</small>
                        </span>
                        <a href="/consultations/edit/@c.Id" class="@(Auth.HasModule(AppModule.Consultations) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>

            <SectionList Title="Pharmacy" Icon="bi-capsule" IconBgClass="feature-icon-violet" Count="_dashboard.Prescriptions.Count">
                @foreach (var p in _dashboard.Prescriptions)
                {
                    <div class="record-item">
                        <span><i class="bi bi-prescription me-1 text-muted"></i> @p.DrugName <StatusBadge Status="p.Status" /></span>
                        <small class="text-muted">@(p.CreatedDate?.ToLocalTime().ToString("g") ?? "—")</small>
                    </div>
                }
            </SectionList>

            <SectionList Title="Laboratory" Icon="bi-droplet-half" IconBgClass="feature-icon-blue" Count="_dashboard.Laboratories.Count">
                @foreach (var l in _dashboard.Laboratories)
                {
                    <div class="record-item">
                        <span>@l.TestName — <strong>@(l.Result ?? "pending")</strong></span>
                        <a href="/laboratory/edit/@l.Id" class="@(Auth.HasModule(AppModule.Laboratory) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>
        </div>

        <div class="col-lg-6">
            <SectionList Title="Dental" Icon="bi-emoji-smile" Count="_dashboard.DentalConsultations.Count">
                @foreach (var d in _dashboard.DentalConsultations)
                {
                    <div class="record-item">
                        <span>@(string.Join(", ", d.Diagnoses.Take(3)))</span>
                        <a href="/dental/edit/@d.Id" class="@(Auth.HasModule(AppModule.Dental) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>

            <SectionList Title="Ancillary" Icon="bi-bandaid" Count="_dashboard.Ancillaries.Count">
                @foreach (var a in _dashboard.Ancillaries)
                {
                    <div class="record-item">
                        <span>@string.Join(", ", a.Services)</span>
                        <a href="/ancillary/edit/@a.Id" class="@(Auth.HasModule(AppModule.Ancillary) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>

            <SectionList Title="Optometrist" Icon="bi-eye" Count="_dashboard.Optometrists.Count">
                @foreach (var o in _dashboard.Optometrists)
                {
                    <div class="record-item">
                        <span>VA R:@o.VisualAcuityRight · L:@o.VisualAcuityLeft</span>
                        <a href="/optometrists/edit/@o.Id" class="@(Auth.HasModule(AppModule.Optometrists) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>

            <SectionList Title="Ophthalmologist" Icon="bi-eye-fill" Count="_dashboard.Ophthalmologists.Count">
                @foreach (var o in _dashboard.Ophthalmologists)
                {
                    <div class="record-item">
                        <span>@(string.Join(", ", o.Diagnoses.Take(3)))</span>
                        <a href="/ophthalmologists/edit/@o.Id" class="@(Auth.HasModule(AppModule.Ophthalmologists) ? "" : "d-none")"><i class="bi bi-pencil me-1"></i>Edit</a>
                    </div>
                }
            </SectionList>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ClientDashboardViewModel? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _dashboard = await Api.GetDashboardAsync(Id);
        _loading = false;
    }
}
