@page "/dental"
@rendermode InteractiveServer
@inject RenaissanceApiClient Api

<PageTitle>Dental - MedReach</PageTitle>

<div class="module-page">
    <PageHeader Title="Dental" Subtitle="Dental consultations and treatments" Icon="bi-emoji-smile" />

    <ReferralQueuePanel Module="AppModule.Dental" />

    <PatientQuickSearch CreateHrefPrefix="/dental/create" ActionLabel="New dental visit" />

    @if (_loading)
    {
        <LoadingState Message="Loading dental records..." />
    }
    else if (_items.Count == 0)
    {
        <EmptyPanel Icon="bi-emoji-smile" Title="No dental records yet" Message="Search for a patient above to start a dental visit." />
    }
    else
    {
        <div class="record-meta"><strong>@_items.Count</strong> recent records</div>

        <div class="module-mobile-list d-md-none">
            @foreach (var d in _items)
            {
                <ModuleMobileCard Patient="Patient(d.PatientId)"
                                  Primary="@(d.Diagnoses.Count == 0 ? "No diagnosis recorded" : string.Join(", ", d.Diagnoses.Take(3)))"
                                  Date="d.CreatedDate"
                                  Href="@($"/dental/edit/{d.Id}")"
                                  Title="Edit dental record"
                                  Icon="bi-pencil" />
            }
        </div>

        <div class="section-card table-card p-0 d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover mb-0 module-record-table module-table-dental">
                    <ModuleRecordColGroup Widths="@(new[] { "28%", "46%", "18%", "4.5rem" })" />
                    <thead>
                        <tr>
                            <ModuleTableTh Label="Patient" Icon="bi-person" />
                            <ModuleTableTh Label="Diagnoses" Icon="bi-emoji-smile" />
                            <ModuleTableTh Label="Recorded" Icon="bi-calendar3" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableActionTh />
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var d in _items)
                    {
                        <tr>
                            <td><ClientIdentity Patient="Patient(d.PatientId)" /></td>
                            <td>
                                @if (d.Diagnoses.Count == 0)
                                {
                                    <span class="record-empty-value">—</span>
                                }
                                else
                                {
                                    <span class="record-field"><i class="bi bi-emoji-smile"></i>@string.Join(", ", d.Diagnoses.Take(3))</span>
                                }
                            </td>
                            <ModuleRecordDate Value="d.CreatedDate" CssClass="d-none d-sm-table-cell" />
                            <ModuleTableAction Href="@($"/dental/edit/{d.Id}")" Title="Edit dental record" Icon="bi-pencil" />
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private List<DentalConsultation> _items = [];
    private Dictionary<Guid, Patient> _patients = [];

    protected override async Task OnInitializedAsync()
    {
        var patients = await Api.GetPatientsAsync();
        _patients = patients.ToDictionary(p => p.Id);
        _items = (await Api.GetDentalsAsync()).Take(50).ToList();
        _loading = false;
    }

    private Patient? Patient(Guid id) => _patients.GetValueOrDefault(id);
}
