@inherits LayoutComponentBase
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject RenaissanceApiClient Api
@implements IDisposable

<div class="ren-app-shell">
    @if (_successMessage is not null)
    {
        <div class="container pt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-check-circle-fill"></i>
                <span class="flex-grow-1">@_successMessage</span>
                <button type="button" class="btn-close" @onclick="DismissAlert"></button>
            </div>
        </div>
    }

    <header class="ren-header">
        <nav class="navbar navbar-expand-lg navbar-dark ren-navbar">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span class="brand-text">@(_facilityName ?? "Renaissance")</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-lg-3 me-auto flex-wrap">
                        <li class="nav-item">
                            <a class="nav-link @(_homeActive ? "active" : "")" href="/">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        @if (Auth.HasModule(AppModule.Clients))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(_clientsActive ? "active" : "")" href="/patients">
                                    <i class="bi bi-people me-1"></i> Patients
                                </a>
                            </li>
                        }
                        @if (_clinical.Count > 0)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(_clinicalActive ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-clipboard2-pulse me-1"></i> Modules
                                </a>
                                <ul class="dropdown-menu">
                                    @foreach (var item in _clinical)
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center justify-content-between gap-2" href="@item.Href">
                                                <span><i class="bi @item.Icon me-2"></i>@item.Label</span>
                                                <ReferralNavBadge Clinical="@(new List<ModuleNavItem> { item })" @rendermode="InteractiveServer" />
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (Auth.HasModule(AppModule.Stakeholders))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(_stakeholdersActive ? "active" : "")" href="/stakeholders">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Stakeholders
                                </a>
                            </li>
                        }
                        @if (Auth.HasModule(AppModule.Administration))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(_adminActive ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock me-1"></i> Admin
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people me-2"></i>Users</a></li>
                                    <li><a class="dropdown-item" href="/admin/roles"><i class="bi bi-key me-2"></i>Roles &amp; modules</a></li>
                                    <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                                    <li><a class="dropdown-item" href="/admin/backup"><i class="bi bi-cloud-arrow-down me-2"></i>Backup</a></li>
                                    <li><a class="dropdown-item" href="/admin/export"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Export records</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @if (Auth.IsAuthenticated)
                    {
                        <ul class="navbar-nav align-items-center gap-2">
                            <li class="nav-item">
                                <ReferralInboxBell @rendermode="InteractiveServer" />
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @Auth.User!.FullName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-item-text text-muted small">@Auth.User.RoleName</li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button class="dropdown-item" type="button" @onclick="LogoutAsync">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                        </button>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="ren-main container">
        @if (_denied)
        {
            <div class="empty-state py-5">
                <i class="bi bi-shield-x d-block fs-1 mb-3"></i>
                <h1 class="h4">You do not have access to this module</h1>
                <p class="text-muted">Ask an administrator to grant this module to your role.</p>
                <a href="/" class="btn btn-primary mt-2"><i class="bi bi-house me-1"></i> Back to home</a>
            </div>
        }
        else
        {
            @Body
        }
    </main>

    <footer class="ren-footer">
        <div class="container ren-footer-inner">
            <span class="ren-footer-copy"><i class="bi bi-shield-check me-1"></i> &copy; @DateTime.Now.Year Renaissance Clinical Data Collection</span>
            <span class="ren-footer-tagline"><i class="bi bi-hospital me-1"></i> Outpatient Care Platform</span>
        </div>
    </footer>
</div>

<ReferralToastHost @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss btn-close" aria-label="Dismiss"></button>
</div>

@code {
    private string? _successMessage;
    private bool _homeActive;
    private bool _clientsActive;
    private bool _clinicalActive;
    private bool _stakeholdersActive;
    private bool _adminActive;
    private bool _denied;
    private List<ModuleNavItem> _clinical = [];
    private string? _facilityName;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnAuthChanged;
        _successMessage = Notifications.TakeMessage();
        ApplyRouteState();
        await LoadFacilityNameAsync();
    }

    private async Task LoadFacilityNameAsync()
    {
        try
        {
            var settings = await Api.GetPublicSettingsAsync();
            _facilityName = settings?.FacilityName;
        }
        catch
        {
            _facilityName = null;
        }
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    private void ApplyRouteState()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        var required = ModuleNav.ModuleForPath(path);

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login");
            return;
        }

        _denied = required is not null && !Auth.HasModule(required.Value);
        _clinical = ModuleNav.Clinical.Where(m => Auth.HasModule(m.Module)).ToList();
        _homeActive = string.IsNullOrEmpty(path);
        _clientsActive = path.StartsWith("patients", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("patient-dashboard", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("client-dashboard", StringComparison.OrdinalIgnoreCase);
        _clinicalActive = _clinical.Any(m => path.StartsWith(m.Href.TrimStart('/'), StringComparison.OrdinalIgnoreCase));
        _stakeholdersActive = path.StartsWith("stakeholders", StringComparison.OrdinalIgnoreCase);
        _adminActive = path.StartsWith("admin", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LogoutAsync()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login", true);
    }

    private void DismissAlert() => _successMessage = null;

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
