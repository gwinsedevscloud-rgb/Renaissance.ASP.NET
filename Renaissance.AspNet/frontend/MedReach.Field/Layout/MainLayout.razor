@inherits LayoutComponentBase
@using MedReach.Field.Services
@inject AuthSessionService Auth
@inject ConnectivityService Connectivity
@inject OutreachCacheService Cache
@inject BackgroundSyncWorker BgSync
@inject NotificationService Notifications
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="ren-app-shell">
    @if (_banner is not null)
    {
        <div class="container pt-3">
            <div class="alert @_bannerClass field-banner alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <i class="bi @_bannerIcon"></i>
                <span class="flex-grow-1">@_banner</span>
                <button type="button" class="btn-close" @onclick="DismissBanner"></button>
            </div>
        </div>
    }

    <header class="ren-header">
        <nav class="navbar navbar-expand-lg navbar-dark ren-navbar">
            <div class="container">
                <a class="navbar-brand" href="">
                    <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                    <span class="brand-text">@FacilityName</span>
                    <span class="field-badge">Field</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#fieldNav"
                        aria-controls="fieldNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="fieldNav">
                    <ul class="navbar-nav ms-lg-3 me-auto flex-wrap">
                        <li class="nav-item">
                            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                                <i class="bi bi-house-door me-1"></i> Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="register">
                                <i class="bi bi-person-vcard me-1"></i> Register
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="patients">
                                <i class="bi bi-people me-1"></i> Patients
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="secondary">
                                <i class="bi bi-capsule-pill me-1"></i> Secondary
                            </NavLink>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-clipboard2-pulse me-1"></i> Clinical
                            </a>
                            <ul class="dropdown-menu">
                                <li><NavLink class="dropdown-item" href="triage"><i class="bi bi-activity me-2"></i>Triage</NavLink></li>
                                <li><NavLink class="dropdown-item" href="laboratory"><i class="bi bi-eyedropper me-2"></i>Laboratory</NavLink></li>
                                <li><NavLink class="dropdown-item" href="consultation"><i class="bi bi-stethoscope me-2"></i>Consultation</NavLink></li>
                                <li><NavLink class="dropdown-item" href="pharmacy"><i class="bi bi-capsule me-2"></i>Pharmacy</NavLink></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><NavLink class="dropdown-item" href="dental"><i class="bi bi-emoji-smile me-2"></i>Dental</NavLink></li>
                                <li><NavLink class="dropdown-item" href="eye"><i class="bi bi-eye me-2"></i>Eye clinic</NavLink></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="sync">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Sync
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="nav-link" href="device">
                                <i class="bi bi-tablet me-1"></i> Device
                            </NavLink>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2">
                        <li class="nav-item">
                            <span class="field-conn-chip @(Connectivity.IsOnline ? "" : "offline")">
                                <span class="field-conn-dot"></span>
                                @(Connectivity.IsOnline ? "Online" : "Offline")
                            </span>
                        </li>
                        @if (Auth.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> <span class="ren-user-name">@(Auth.User?.FullName ?? Auth.User?.UserName)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="dropdown-item-text text-muted small">@(Auth.User?.RoleName ?? "Field staff")</li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <button class="dropdown-item" type="button" @onclick="LogoutAsync">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign out
                                        </button>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="login"><i class="bi bi-box-arrow-in-right me-1"></i> Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="ren-main container">
        @Body
    </main>

    <footer class="ren-footer">
        <div class="container ren-footer-inner">
            <span class="ren-footer-copy"><i class="bi bi-shield-check me-1"></i> &copy; @DateTime.Now.Year MedReach Clinical Data Collection</span>
            <span class="ren-footer-tagline"><i class="bi bi-tablet me-1"></i> Field offline PWA</span>
        </div>
    </footer>

    <ToastHost />
</div>

@code {
    private string? _banner;
    private ToastKind _bannerKind = ToastKind.Success;

    private string FacilityName => Cache.Cached?.FacilityName ?? "MedReach";

    private string _bannerClass => _bannerKind switch
    {
        ToastKind.Success => "alert-success",
        ToastKind.Error => "alert-danger",
        ToastKind.Warning => "alert-warning",
        _ => "alert-info"
    };

    private string _bannerIcon => _bannerKind switch
    {
        ToastKind.Success => "bi-check-circle-fill",
        ToastKind.Error => "bi-exclamation-octagon-fill",
        ToastKind.Warning => "bi-exclamation-triangle-fill",
        _ => "bi-info-circle-fill"
    };

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        await Cache.LoadAsync();
        await Connectivity.InitializeAsync();
        Auth.Changed += OnChanged;
        Connectivity.Changed += OnChanged;
        BgSync.Changed += OnBg;
        Notifications.BannerChanged += OnBanner;
        Nav.LocationChanged += OnLocationChanged;
        _banner = Notifications.TakeBanner();
        _bannerKind = Notifications.BannerKind;

        if (Auth.IsAuthenticated)
        {
            BgSync.Start();
        }

        if (!Auth.IsAuthenticated && !Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo("login");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("renaissanceSyncHeaderHeight");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    private void OnBanner() => InvokeAsync(() =>
    {
        _banner = Notifications.BannerMessage;
        _bannerKind = Notifications.BannerKind;
        StateHasChanged();
    });

    private void OnBg() => InvokeAsync(StateHasChanged);

    private void OnChanged()
    {
        if (Auth.IsAuthenticated)
        {
            BgSync.Start();
        }

        InvokeAsync(StateHasChanged);
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        try
        {
            await JS.InvokeVoidAsync("renaissanceCloseMainNav");
            await JS.InvokeVoidAsync("renaissanceSyncHeaderHeight");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }

        await InvokeAsync(StateHasChanged);
    }

    private void DismissBanner()
    {
        Notifications.ClearBanner();
        _banner = null;
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("login");
    }

    public async ValueTask DisposeAsync()
    {
        Auth.Changed -= OnChanged;
        Connectivity.Changed -= OnChanged;
        BgSync.Changed -= OnBg;
        Notifications.BannerChanged -= OnBanner;
        Nav.LocationChanged -= OnLocationChanged;
        await BgSync.DisposeAsync();
        await Connectivity.DisposeAsync();
    }
}
