<div class="d-flex flex-wrap gap-2 align-items-center mt-3 pt-3 border-top">
    <button class="btn btn-primary" type="submit" disabled="@Saving">
        @if (Saving)
        {
            <span class="spinner-border spinner-border-sm me-1"></span>
        }
        else
        {
            <i class="bi @SaveIcon me-1"></i>
        }
        @SaveLabel
    </button>
    @if (!string.IsNullOrWhiteSpace(CancelHref))
    {
        <a class="btn btn-outline-secondary" href="@CancelHref">
            <i class="bi bi-x-lg me-1"></i>@CancelLabel
        </a>
    }
    @ChildContent
</div>

@code {
    [Parameter]
    public string SaveLabel { get; set; } = "Save offline";

    [Parameter]
    public string SaveIcon { get; set; } = "bi-save";

    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public string? CancelHref { get; set; }

    [Parameter]
    public string CancelLabel { get; set; } = "Cancel";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
