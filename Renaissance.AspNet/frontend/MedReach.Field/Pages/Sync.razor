@page "/sync"
@using MedReach.Field.Models
@using MedReach.Field.Services
@inject AuthSessionService Auth
@inject FieldQueueService Queue
@inject SyncOrchestrator SyncOrch
@inject ConnectivityService Connectivity
@inject BackgroundSyncWorker BgSync
@inject NotificationService Notifications
@implements IDisposable

<PageTitle>Sync queue - MedReach</PageTitle>

<StationHeader Title="Sync queue" Subtitle="Push offline records · conflicts shown below" Icon="bi-cloud-arrow-up">
    <Trailing>
        @if (Auth.IsAuthenticated)
        {
            <button class="btn btn-light btn-sm" type="button" disabled="@(_busy || !Connectivity.IsOnline)" @onclick="PushAsync">
                <i class="bi bi-cloud-upload me-1"></i> Push now
            </button>
        }
    </Trailing>
</StationHeader>

@if (Auth.IsAuthenticated)
{
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-primary" type="button" disabled="@(_busy || !Connectivity.IsOnline)" @onclick="PushAsync">
            <i class="bi bi-cloud-upload me-1"></i> Push to hospital
        </button>
        <button class="btn btn-outline-primary" type="button" disabled="@(_busy || !Connectivity.IsOnline)" @onclick="PullAsync">
            <i class="bi bi-arrow-repeat me-1"></i> Refresh settings
        </button>
        <button class="btn btn-outline-secondary" type="button" disabled="@_busy" @onclick="ClearSyncedAsync">Clear synced</button>
        <button class="btn btn-outline-warning" type="button" disabled="@_busy" @onclick="RetryFailedAsync">Retry failed</button>
        <button class="btn btn-outline-secondary" type="button" disabled="@_busy" @onclick="ExportAsync">
            <i class="bi bi-download me-1"></i> Export JSON
        </button>
    </div>
}

@if (!Auth.IsAuthenticated)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>Please <a href="login">sign in</a> first.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(BgSync.LastStatus))
    {
        <div class="alert alert-light border small mb-3">
            <i class="bi bi-arrow-repeat me-1"></i>@BgSync.LastStatus
        </div>
    }

    @if (_failed.Count > 0)
    {
        <div class="section-card mb-3 border-danger">
            <div class="section-card-header">
                <span class="section-icon text-danger"><i class="bi bi-exclamation-octagon"></i></span>
                <h2>Conflicts / rejections (@_failed.Count)</h2>
            </div>
            <p class="text-muted small">The hospital API rejected these records. Fix data on the tablet, retry, or discard.</p>
            @foreach (var item in _failed)
            {
                <div class="border rounded p-3 mb-2 @(item.ClientRecordId == _selectedFail?.ClientRecordId ? "border-danger" : "")">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <strong class="text-capitalize">@item.Type</strong>
                            — @(item.DisplayName ?? "Untitled")
                            <div class="small text-danger mt-1">@(item.LastError ?? "Rejected")</div>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <button class="btn btn-sm btn-outline-primary" type="button" disabled="@_busy" @onclick="() => RetryOneAsync(item)">Retry</button>
                            <button class="btn btn-sm btn-outline-danger" type="button" disabled="@_busy" @onclick="() => DiscardAsync(item)">Discard</button>
                            <button class="btn btn-sm btn-link" type="button" @onclick="() => _selectedFail = item">Details</button>
                        </div>
                    </div>
                </div>
            }
            @if (_selectedFail is not null)
            {
                <div class="alert alert-warning mb-0 mt-2">
                    <div><strong>Client record:</strong> <code>@_selectedFail.ClientRecordId</code></div>
                    <div><strong>Captured:</strong> @_selectedFail.CapturedAtUtc.ToString("u")</div>
                    <div><strong>Server message:</strong> @(_selectedFail.LastError ?? "—")</div>
                    <div class="mt-2 small text-muted">Typical fixes: missing patient link (sync patient first), invalid pre-printed ID, inactive care program, or permission.</div>
                </div>
            }
        </div>
    }

    @if (_items.Count == 0)
    {
        <div class="empty-state py-5">
            <i class="bi bi-inbox d-block fs-1 mb-3"></i>
            <h2 class="h5">Queue is empty</h2>
            <p class="text-muted">Registered patients and clinical encounters appear here until synced.</p>
            <a class="btn btn-primary" href="register"><i class="bi bi-person-plus me-1"></i> Register patient</a>
        </div>
    }
    else
    {
        <div class="section-card p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>When (UTC)</th>
                            <th>Type</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr class="@(item.Status == "failed" ? "table-danger" : null)">
                                <td>@item.CapturedAtUtc.ToString("g")</td>
                                <td class="text-capitalize">@item.Type</td>
                                <td>@(item.DisplayName ?? "—")</td>
                                <td><span class="badge @StatusClass(item.Status)">@item.Status</span></td>
                                <td class="small text-muted">@(item.ClientNumber ?? item.LastError ?? item.ServerId?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private List<QueueItem> _items = [];
    private List<QueueItem> _failed = [];
    private QueueItem? _selectedFail;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        BgSync.Changed += OnBg;
        if (Auth.IsAuthenticated)
        {
            await ReloadAsync();
        }
    }

    private void OnBg() => InvokeAsync(StateHasChanged);
    public void Dispose() => BgSync.Changed -= OnBg;

    private static string StatusClass(string status) => status switch
    {
        "synced" => "text-bg-success",
        "pending" => "text-bg-warning",
        "failed" => "text-bg-danger",
        _ => "text-bg-secondary"
    };

    private async Task ReloadAsync()
    {
        _items = (await Queue.GetAllAsync()).OrderByDescending(x => x.CapturedAtUtc).ToList();
        _failed = _items.Where(x => string.Equals(x.Status, "failed", StringComparison.OrdinalIgnoreCase)).ToList();
        if (_selectedFail is not null && _failed.All(x => x.ClientRecordId != _selectedFail.ClientRecordId))
        {
            _selectedFail = null;
        }
    }

    private async Task PushAsync()
    {
        _busy = true;
        try
        {
            var result = await SyncOrch.PushQueueAsync();
            NotifyPush(result);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private void NotifyPush((int Accepted, int Failed, string Message) result)
    {
        if (result.Failed > 0) Notifications.ShowWarning(result.Message);
        else Notifications.ShowSuccess(result.Message);
    }

    private async Task PullAsync()
    {
        _busy = true;
        try
        {
            var result = await SyncOrch.PullConfigAsync();
            if (result.Ok) Notifications.ShowSuccess(result.Message);
            else Notifications.ShowWarning(result.Message);
        }
        finally { _busy = false; }
    }

    private async Task ClearSyncedAsync()
    {
        _busy = true;
        try
        {
            await Queue.ClearSyncedAsync();
            await ReloadAsync();
            Notifications.ShowInfo("Cleared synced items from this tablet.");
        }
        finally { _busy = false; }
    }

    private async Task RetryFailedAsync()
    {
        _busy = true;
        try
        {
            await Queue.RetryFailedAsync();
            var result = await SyncOrch.PushQueueAsync();
            NotifyPush(result);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task RetryOneAsync(QueueItem item)
    {
        _busy = true;
        try
        {
            item.Status = "pending";
            item.LastError = null;
            await Queue.EnqueueAsync(item);
            var result = await SyncOrch.PushQueueAsync();
            NotifyPush(result);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DiscardAsync(QueueItem item)
    {
        _busy = true;
        try
        {
            await Queue.DiscardAsync(item.ClientRecordId);
            if (_selectedFail?.ClientRecordId == item.ClientRecordId) _selectedFail = null;
            await ReloadAsync();
            Notifications.ShowWarning("Discarded rejected record from this tablet.");
        }
        finally { _busy = false; }
    }

    private async Task ExportAsync()
    {
        await Queue.ExportJsonAsync();
        Notifications.ToastInfo("Exported", "Queue downloaded as JSON.");
    }
}
