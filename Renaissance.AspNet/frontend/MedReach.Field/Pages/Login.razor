@page "/login"
@layout LoginLayout
@implements IAsyncDisposable
@using MedReach.Field.Models
@using MedReach.Field.Services
@inject FieldApiClient Api
@inject AuthSessionService Auth
@inject SyncOrchestrator SyncOrch
@inject ConnectivityService Connectivity
@inject OutreachCacheService Cache
@inject NotificationService Notifications
@inject NavigationManager Nav

<PageTitle>Sign in - MedReach Field</PageTitle>

<div class="login-stage">
    <div class="login-backdrop" aria-hidden="true">
        <div class="login-carousel">
            @for (var i = 0; i < _slides.Length; i++)
            {
                var slide = _slides[i];
                <div class="login-slide @(_activeSlide == i ? "is-active" : null)">
                    <div class="login-slide-photo" style="background-image: url('@slide.ImageUrl');"></div>
                </div>
            }
        </div>
        <div class="login-backdrop-wash"></div>
    </div>

    <section class="login-panel" aria-labelledby="login-heading">
        <div class="login-panel-shell">
            <header class="login-brand">
                <p class="login-kicker">
                    <span class="login-kicker-pulse" aria-hidden="true"></span>
                    Medical outreach for communities
                </p>
                <h1 class="login-wordmark">MedReach</h1>
                @if (!string.IsNullOrWhiteSpace(_facilityName))
                {
                    <p class="login-facility">@_facilityName</p>
                }
            </header>

            <div class="login-card">
                <header class="login-panel-head">
                    <span class="login-mark" aria-hidden="true">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </span>
                    <div>
                        <h2 id="login-heading">Welcome back</h2>
                        <p>Sign in to continue Field outreach work.</p>
                    </div>
                </header>

                @if (Auth.IsAuthenticated)
                {
                    <div class="login-alert login-alert-success" role="status">
                        Signed in as <strong>@(Auth.User?.FullName ?? Auth.User?.UserName)</strong>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <a class="btn btn-primary login-submit flex-grow-1" href="">Continue</a>
                        <button class="btn btn-outline-secondary" type="button" @onclick="LogoutAsync">Sign out</button>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="login-alert" role="alert">@_error</div>
                    }

                    <EditForm Model="_model" OnValidSubmit="LoginAsync" class="login-form">
                        <div class="login-field">
                            <label class="form-label" for="username">Username</label>
                            <div class="form-input-group">
                                <span class="form-input-icon"><i class="bi bi-person"></i></span>
                                <InputText id="username" class="form-control" @bind-Value="_model.UserName" autocomplete="username" />
                            </div>
                        </div>
                        <div class="login-field">
                            <label class="form-label" for="password">Password</label>
                            <div class="form-input-group">
                                <span class="form-input-icon"><i class="bi bi-lock"></i></span>
                                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" autocomplete="current-password" />
                            </div>
                        </div>
                        <button class="btn btn-primary login-submit" type="submit" disabled="@(_busy || !Connectivity.IsOnline)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            else
                            {
                                <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                            }
                            Sign in
                        </button>
                    </EditForm>

                    @if (!Connectivity.IsOnline)
                    {
                        <p class="login-footnote text-danger"><i class="bi bi-wifi-off me-1"></i>Connect once to sign in, then work offline.</p>
                    }
                    else
                    {
                        <p class="login-footnote">Same hospital credentials as MedReach web</p>
                    }
                }
            </div>
        </div>
    </section>
</div>

@code {
    private readonly LoginRequest _model = new();
    private bool _busy;
    private string? _error;
    private string? _facilityName;
    private int _activeSlide;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private Task? _carouselTask;

    private static readonly OutreachSlide[] _slides =
    [
        new("Dental", "images/login/dental.png"),
        new("Eye", "images/login/eye.png"),
        new("Children Deworming", "https://images.unsplash.com/photo-1509099836639-18ba1795216d?auto=format&fit=crop&w=1600&q=80"),
        new("Insecticide Treated Net", "images/login/itn.png")
    ];

    protected override async Task OnInitializedAsync()
    {
        await Auth.LoadAsync();
        await Cache.LoadAsync();
        try
        {
            await Connectivity.InitializeAsync();
        }
        catch
        {
            // Connectivity JS may already be bound from a prior layout.
        }

        _facilityName = Cache.Cached?.FacilityName;

        if (Auth.IsAuthenticated)
        {
            Nav.NavigateTo("");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _timer is not null)
        {
            return;
        }

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5.5));
        _carouselTask = RunCarouselAsync(_cts.Token);
    }

    private async Task RunCarouselAsync(CancellationToken ct)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(ct))
            {
                _activeSlide = (_activeSlide + 1) % _slides.Length;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on dispose.
        }
    }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model);
            if (result is null || string.IsNullOrWhiteSpace(result.Token))
            {
                _error = "Invalid username or password.";
                Notifications.ToastError("Sign in failed", _error);
                return;
            }

            await Auth.SetAsync(result);
            await SyncOrch.PullConfigAsync();
            await Cache.LoadAsync();
            _facilityName = Cache.Cached?.FacilityName;
            Notifications.ToastSuccess("Welcome", Auth.User?.FullName ?? "Signed in");
            Nav.NavigateTo("");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Notifications.ToastError("Sign in failed", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts is not null)
        {
            await _cts.CancelAsync();
            _cts.Dispose();
            _cts = null;
        }

        _timer?.Dispose();
        _timer = null;

        if (_carouselTask is not null)
        {
            try { await _carouselTask; } catch { /* ignore */ }
        }
    }

    private sealed record OutreachSlide(string Title, string ImageUrl);
}
