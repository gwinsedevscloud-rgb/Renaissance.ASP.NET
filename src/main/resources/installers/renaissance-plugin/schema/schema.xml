<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <property name="autoIncrement" value="true"/>
    <changeSet id="tutorial-1" author="mattae">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ren_tutorial"/>
            </not>
        </preConditions>
        <createTable tableName="ren_tutorial">
            <column name="id" type="serial" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(512)">
                <constraints nullable="false"/>
            </column>
            <column name="published" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-patient-table" author="Anana">
        <createTable tableName="patient">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Patient fields -->
            <column name="client_number" type="varchar(100)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="age" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="age_unit" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="sex" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="marital_status" type="varchar(50)"/>
            <column name="tribe" type="varchar(100)"/>
            <column name="religion" type="varchar(100)"/>
            <column name="occupation" type="varchar(100)"/>
            <column name="education" type="varchar(100)"/>
            <column name="address" type="text"/>

            <!-- Audit fields -->
            <column name="created_by" type="varchar(255)"/>
            <column name="created_date" type="timestamp"/>
            <column name="updated_by" type="varchar(255)"/>
            <column name="updated_date" type="timestamp"/>
            <column name="archived" type="boolean" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <changeSet id="create-triage-table" author="Anana">

        <createTable tableName="ren_triage">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Foreign Key to Patient -->
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <!-- Medical History -->
            <column name="diabetes" type="BOOLEAN"/>
            <column name="asthma" type="BOOLEAN"/>
            <column name="sickle_cell" type="BOOLEAN"/>
            <column name="smoking" type="BOOLEAN"/>

            <!-- Anthropometry -->
            <column name="weight" type="DECIMAL(5,2)"/>
            <column name="height" type="DECIMAL(5,2)"/>

            <!-- Vital Signs -->
            <column name="temperature" type="DECIMAL(4,1)"/>
            <column name="systolic_bp" type="INT"/>
            <column name="diastolic_bp" type="INT"/>
            <column name="pulse_rate" type="INT"/>
            <column name="respiratory_rate" type="INT"/>

            <!-- Audit Columns -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>

        </createTable>

        <!-- Foreign Key Constraint -->
        <addForeignKeyConstraint
            baseTableName="ren_triage"
            baseColumnNames="patient_id"
            constraintName="fk_triage_patient"
            referencedTableName="patient"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="create-pharmacy-prescription-table" author="Anana">
        <createTable tableName="ren_pharmacy_prescription">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="patient_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_pharmacy_patient"
                             referencedTableName="patient" referencedColumnNames="id"/>
            </column>

            <column name="drug_category" type="VARCHAR(255)"/>
            <column name="drug_name" type="VARCHAR(255)"/>
            <column name="dosage" type="VARCHAR(100)"/>
            <column name="frequency" type="VARCHAR(100)"/>
            <column name="duration" type="VARCHAR(100)"/>
            <column name="dispensed" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="dispensation_note" type="VARCHAR(255)"/>

            <!-- Audit fields from AuditEntity -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <changeSet id="20250721-1-add-status-to-pharmacy" author="Anana">
        <addColumn tableName="ren_pharmacy_prescription">
            <column name="status" type="varchar(20)" defaultValue="PENDING"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-quantity-dispensed-to-pharmacy" author="Anana">
        <addColumn tableName="ren_pharmacy_prescription">
            <column name="quantity_dispensed" type="int"/>
        </addColumn>
    </changeSet>

    <changeSet id="create-ren-laboratory-table" author="chatgpt">
        <createTable tableName="ren_laboratory">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="test_name" type="VARCHAR(255)"/>
            <column name="result" type="VARCHAR(255)"/>
            <column name="note" type="TEXT"/>

            <!-- Audit fields from AuditEntity -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>

        </createTable>

        <!-- Foreign key constraint -->
        <addForeignKeyConstraint
            baseTableName="ren_laboratory"
            baseColumnNames="patient_id"
            referencedTableName="patient"
            referencedColumnNames="id"
            constraintName="fk_ren_laboratory_patient"/>
    </changeSet>

    <changeSet id="create-consultation-table" author="yourname">
        <createTable tableName="consultation">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="diagnoses" type="TEXT[]"/>
            <column name="treatments" type="TEXT[]"/>
            <column name="services_referred" type="TEXT[]"/>
            <column name="referred" type="BOOLEAN"/>

            <!-- Audit Fields -->
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(100)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="consultation"
            baseColumnNames="patient_id"
            referencedTableName="patient"
            referencedColumnNames="id"
            constraintName="fk_consultation_patient"/>
    </changeSet>

    <changeSet id="create-client-number-sequence" author="Anana">
        <createTable tableName="client_number_sequence">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="version" type="BIGINT"/>
            <column name="last_sequence" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet id="create-dental-consultation-table" author="ren_dental_consultation">
        <createTable tableName="dental_consultation">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="patient_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_dental_patient"
                             referencedTableName="patient" referencedColumnNames="id"/>
            </column>

            <column name="diagnoses" type="text[]"/>
            <column name="treatments" type="text[]"/>

            <!-- Audit fields -->
            <column name="created_by" type="varchar(100)"/>
            <column name="created_date" type="timestamp"/>
            <column name="updated_by" type="varchar(100)"/>
            <column name="updated_date" type="timestamp"/>
            <column name="archived" type="boolean" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <changeSet id="add-dispensed-items-column-to-dental-consultation" author="Anana">
        <addColumn tableName="dental_consultation">
            <column name="dispensed_items" type="text[]"/>
        </addColumn>
    </changeSet>

    <changeSet id="create-ancillary-service-table1" author="Anana">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ancillary_service"/>
            </not>
        </preConditions>
        <createTable tableName="ancillary_service">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="services" type="text[]">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="varchar(100)"/>
            <column name="created_date" type="timestamp"/>
            <column name="updated_by" type="varchar(100)"/>
            <column name="updated_date" type="timestamp"/>
            <column name="archived" type="boolean" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="ancillary_service"
            baseColumnNames="patient_id"
            referencedTableName="patient"
            referencedColumnNames="id"
            constraintName="fk_ancillary_service_patient"/>
    </changeSet>

    <changeSet id="add-client-number-index" author="Anana">
        <createIndex indexName="idx_patient_client_number"
                     tableName="patient"
                     unique="false">
            <column name="client_number"/>
        </createIndex>
    </changeSet>

    <changeSet id="add-itn-columns-to-consultation" author="Anana">
        <addColumn tableName="consultation">
            <column name="itn_order" type="boolean" defaultValueBoolean="false"/>
            <column name="itn_dispense" type="boolean" defaultValueBoolean="false"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-others-columns-to-consultation" author="Anana">
        <addColumn tableName="consultation">
            <column name="others_diagnosis" type="text[]"/>
            <column name="others_treatment" type="text[]"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-fields-to-dental-consultation_" author="Anana">
        <addColumn tableName="dental_consultation">
            <column name="services_referred" type="text[]">
                <constraints nullable="true"/>
            </column>
            <column name="referred" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="others_diagnosis" type="text[]">
                <constraints nullable="true"/>
            </column>
            <column name="others_treatment" type="text[]">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Create ophthalmologist table -->
    <changeSet id="2025-01-create-ophthalmologist" author="Anana">
        <createTable tableName="ren_ophthalmologist">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="referred" type="BOOLEAN"/>
            <column name="diagnosis" type="TEXT[]"/>
            <column name="treatments" type="TEXT[]"/>
            <column name="surgery" type="TEXT[]"/>
            <column name="others_diagnosis" type="TEXT[]"/>
            <column name="others_treatment" type="TEXT[]"/>

            <!-- Audit Fields -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>
    </changeSet>

    <!-- Create optometrist table -->
    <changeSet id="2025-02-create-optometrist" author="Anana">
        <createTable tableName="ren_optometrist">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="patient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="visual_acuity_right" type="VARCHAR(255)"/>
            <column name="visual_acuity_left" type="VARCHAR(255)"/>
            <column name="glasses_dispensed" type="BOOLEAN"/>
            <column name="referred" type="BOOLEAN"/>

            <!-- Audit Fields -->
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_date" type="TIMESTAMP"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_date" type="TIMESTAMP"/>
            <column name="archived" type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="ren_optometrist"
            baseColumnNames="patient_id"
            referencedTableName="patient"
            referencedColumnNames="id"
            constraintName="fk_optometrist_patient"/>
    </changeSet>

    <changeSet id="add-other-surgery-fields-to-eye-service" author="Anana">
        <addColumn tableName="ren_ophthalmologist">
            <column name="other_surgery" type="text[]">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-visual-acuity-fields-to-ren-ophthalmologist" author="Anana">
        <addColumn tableName="ren_ophthalmologist">
            <column name="visual_acuity_right" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="visual_acuity_left" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="glasses_dispensed" type="varchar(10)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="add-pregnancy-status-to-ancillary-service-table" author="Anana">
        <addColumn tableName="ancillary_service">
            <column name="pregnancy_status" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
